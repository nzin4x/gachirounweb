<script>
  // Smooth scroll for hashbang navigation
  document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash;
    if (hash) {
      setTimeout(() => {
        const element = document.querySelector(hash);
        if (element) {
          element.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 100);
    }
  });

  // Track hashbang navigation
  window.addEventListener('hashchange', () => {
    if (typeof window.gtag !== 'undefined') {
      window.gtag('config', 'GTM-MVL6P7N7', {
        page_path: window.location.pathname + window.location.hash
      });
    }
  });

  // Dynamic title based on scroll position
  const sectionTitles: Record<string, string> = {
    'value': '가치란',
    'cycle': '가치로운의 순환구조',
    'vision': '경영철학 & 비전',
    'greeting': '인사말',
    'history': '연혁',
    'organization': '조직 소개',
    'location': '사무실 위치'
  };

  function updateTitle() {
    const hash = window.location.hash.replace('#', '') || 'value';
    const sectionTitle = sectionTitles[hash] || '가치란';
    document.title = `소개 > ${sectionTitle} | 사회적협동조합 가치로운`;
  }

  window.addEventListener('hashchange', updateTitle);
  
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const sections = document.querySelectorAll('section[id]');
        let currentSection = 'value';
        
        sections.forEach(section => {
          const rect = section.getBoundingClientRect();
          if (rect.top <= 150 && rect.bottom >= 150) {
            currentSection = section.id;
          }
        });
        
        const newHash = '#' + currentSection;
        if (window.location.hash !== newHash) {
          history.replaceState(null, '', newHash);
          updateTitle();
        }
        
        ticking = false;
      });
      ticking = true;
    }
  });

  document.addEventListener('DOMContentLoaded', updateTitle);
  updateTitle();

  // Admin tools: Data refetch and path overlay
  let showingDataPaths = false;
  let liveUpdatesEnabled = false;
  let liveUpdateInterval: number | null = null;
  let pathLabelRaf: number | null = null;
  type PathLabelEntry = {
    element: HTMLElement;
    label: HTMLElement;
  };
  const pathLabels: PathLabelEntry[] = [];

  // Listen for command palette actions
  window.addEventListener('message', (e) => {
    if (e.data?.type === 'refetch-greeting') {
      refetchGreeting();
    } else if (e.data?.type === 'toggle-data-paths') {
      toggleDataPaths();
    } else if (e.data?.type === 'toggle-live-updates') {
      toggleLiveUpdates();
    }
  });

  async function refetchGreeting() {
    try {
      console.log('[Admin] Refetching greeting data...');
      const response = await fetch('/api/greeting');
      
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const data = await response.json();
      console.log('[Admin] Received data:', data);

      // Update DOM elements
      const titleEl = document.getElementById('greeting-title');
      const bodyEl = document.getElementById('greeting-body');
      const writtenbyEl = document.getElementById('greeting-writtenby');

      if (titleEl && data.title) {
        titleEl.textContent = data.title;
      }
      if (bodyEl && data.body) {
        bodyEl.innerHTML = data.body;
      }
      if (writtenbyEl && data.writtenby) {
        writtenbyEl.textContent = data.writtenby;
      }

      // Show success toast
      showToast('✅ 데이터가 성공적으로 갱신되었습니다!');
    } catch (error) {
      console.error('[Admin] Failed to refetch:', error);
      showToast('❌ 데이터 갱신 실패: ' + (error instanceof Error ? error.message : String(error)));
    }
  }

  function toggleDataPaths() {
    if (showingDataPaths) {
      // Hide data paths
      pathLabels.forEach(entry => entry.label.remove());
      pathLabels.length = 0;
      showingDataPaths = false;
      showToast('📍 데이터 위치 표시가 꺼졌습니다');
    } else {
      // Show data paths
      const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-strapi-path]'));
      if (!elements.length) {
        showToast('⚠️ 표시할 데이터 위치가 없습니다. data-strapi-path 속성을 확인하세요.');
        return;
      }

      // Determine Strapi admin base URL
      const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      const strapiBaseUrl = isLocal 
        ? 'http://localhost:1337' 
        : 'https://faithful-dog-1d263d2e88.strapiapp.com';

      elements.forEach((element) => {
        const path = element.getAttribute('data-strapi-path');
        if (!path) return;

        // Convert path to Strapi admin URL
        const pathParts = path.split(' > ');
        let adminUrl = '';
        let displayPath = path;

        if (pathParts.length >= 3) {
          const [type, apiName, contentType, ...fieldParts] = pathParts;
          
          if (type === 'single-types') {
            adminUrl = `${strapiBaseUrl}/admin/content-manager/single-types/api::${apiName}.${apiName}`;
          } else if (type === 'collection-types') {
            // For collection types, we need an ID, but for now just show the list
            adminUrl = `${strapiBaseUrl}/admin/content-manager/collection-types/api::${apiName}.${contentType}`;
          }
          
          // Add field info for better UX
          if (fieldParts.length > 0) {
            displayPath = `${path} → 편집`;
          }
        }

        const label = document.createElement('div');
        label.textContent = displayPath;
        label.style.cssText = `
          position: absolute;
          background: rgba(255, 165, 56, 0.92);
          color: #fff;
          padding: 4px 8px;
          border-radius: 4px;
          font-size: 12px;
          font-weight: bold;
          z-index: 9999;
          cursor: pointer;
          border: 2px solid #ff6b35;
          box-shadow: 0 2px 6px rgba(0,0,0,0.25);
          max-width: 320px;
          word-wrap: break-word;
          pointer-events: auto;
        `;

        label.addEventListener('click', () => {
          const copyText = adminUrl || path;
          navigator.clipboard.writeText(copyText).then(() => {
            showToast(`📋 Strapi 편집 URL이 클립보드에 복사되었습니다`);
            // Optionally open in new tab
            if (adminUrl) {
              window.open(adminUrl, '_blank');
            }
          }).catch(() => {
            showToast('⚠️ URL 복사에 실패했습니다.');
          });
        });

        document.body.appendChild(label);
        const entry: PathLabelEntry = { element, label };
        pathLabels.push(entry);
        positionDataPathLabel(entry);
      });

      showingDataPaths = true;
      showToast(`📍 ${elements.length}개의 데이터 위치가 표시되었습니다 (클릭하여 경로 복사)`);
    }

    // Notify CommandPalette of status change
    window.postMessage({ type: 'data-paths-status-changed', enabled: showingDataPaths }, '*');
  }

  function positionDataPathLabel(entry: PathLabelEntry) {
    const rect = entry.element.getBoundingClientRect();
    const scrollY = window.scrollY || document.documentElement.scrollTop;
    const scrollX = window.scrollX || document.documentElement.scrollLeft;
    const offsetY = Math.max(0, rect.top + scrollY - 28);
    const offsetX = scrollX + rect.left;
    entry.label.style.top = `${offsetY}px`;
    entry.label.style.left = `${offsetX}px`;
  }

  function schedulePathLabelUpdate() {
    if (!showingDataPaths) return;
    if (pathLabelRaf !== null) return;
    pathLabelRaf = window.requestAnimationFrame(() => {
      pathLabelRaf = null;
      pathLabels.forEach(positionDataPathLabel);
    });
  }

  window.addEventListener('scroll', schedulePathLabelUpdate);
  window.addEventListener('resize', schedulePathLabelUpdate);

  function toggleLiveUpdates() {
    liveUpdatesEnabled = !liveUpdatesEnabled;
    
    if (liveUpdatesEnabled) {
      // Start polling every 30 seconds
      liveUpdateInterval = window.setInterval(() => {
        console.log('[Live Updates] Checking for changes...');
        refetchGreeting();
      }, 30000);
      showToast('🟢 실시간 업데이트가 켜졌습니다 (30초마다 확인)');
    } else {
      // Stop polling
      if (liveUpdateInterval) {
        clearInterval(liveUpdateInterval);
        liveUpdateInterval = null;
      }
      showToast('🔴 실시간 업데이트가 꺼졌습니다');
    }

    // Notify CommandPalette of status change
    window.postMessage({ type: 'live-update-status-changed', enabled: liveUpdatesEnabled }, '*');
  }

  function showToast(message: string) {
    const toast = document.createElement('div');
    toast.textContent = message;
    toast.style.cssText = `
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      padding: 1rem 1.5rem;
      background: rgba(0, 0, 0, 0.9);
      color: white;
      border-radius: 8px;
      font-size: 0.9rem;
      z-index: 10000;
      animation: fadeIn 0.3s ease;
    `;
    document.body.appendChild(toast);
    
    setTimeout(() => {
      toast.style.animation = 'fadeOut 0.3s ease';
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }
</script>
