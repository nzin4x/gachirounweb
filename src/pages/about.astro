---
import MainLayout from '../layouts/MainLayout.astro';
import { getHistories } from '../lib/strapi';
import strapiClient from '../lib/strapi';
import CommandPalette from '../components/react/CommandPalette';
import { getEnv } from '../lib/env';
import rawHistoryData from '../data/history.json';

// 환경 변수 공통 헬퍼 사용
const env = getEnv(Astro.locals);


// Strapi API: histories (collection type) - fields: date, title, description, link, linkText, show
const historyData: any[] = await (async () => {
  try {
    const list = await getHistories(env);
    if (Array.isArray(list) && list.length > 0) {
      console.log('[About] Loaded', list.length, 'histories from Strapi');
      return list;
    }
    console.warn('[About] No histories from Strapi, using sample data');
    // Fallback: 샘플 데이터 사용 (show === true만, date 내림차순 정렬)
    return rawHistoryData
      .filter(item => item.show)
      .sort((a, b) => {
        const parseDate = (str: string) => {
          const [y, m, d] = str.split('.').map(Number);
          return new Date(y, (m || 1) - 1, d || 1).getTime();
        };
        return parseDate(b.date) - parseDate(a.date);
      })
      .map((item, idx) => ({
        ...item,
        id: `history-${idx}`,
        _strapiPath: `collection-types > histories > history-${idx}`,
        _strapiFields: {
          date: `collection-types > histories > history-${idx} > date`,
          title: `collection-types > histories > history-${idx} > title`,
          description: `collection-types > histories > history-${idx} > description`,
          link: `collection-types > histories > history-${idx} > link`,
          linkText: `collection-types > histories > history-${idx} > linkText`
        }
      }));
  } catch (e) {
    console.error('[About] Failed to load histories:', e);
    // 오류 시 샘플 데이터 사용
    return rawHistoryData
      .filter(item => item.show)
      .sort((a, b) => {
        const parseDate = (str: string) => {
          const [y, m, d] = str.split('.').map(Number);
          return new Date(y, (m || 1) - 1, d || 1).getTime();
        };
        return parseDate(b.date) - parseDate(a.date);
      })
      .map((item, idx) => ({
        ...item,
        id: `history-${idx}`,
        _strapiPath: `collection-types > histories > history-${idx}`,
        _strapiFields: {
          date: `collection-types > histories > history-${idx} > date`,
          title: `collection-types > histories > history-${idx} > title`,
          description: `collection-types > histories > history-${idx} > description`,
          link: `collection-types > histories > history-${idx} > link`,
          linkText: `collection-types > histories > history-${idx} > linkText`
        }
      }));
  }
})();

// Strapi API: greeting (single type) - fields: title, body, writtenby
const greetingData = await (async () => {
  try {
    const g = await strapiClient.getGreeting(env);
    return g;
  } catch (e) {
    console.warn('[About] Failed to load greeting from Strapi');
    return null;
  }
})();
---

<MainLayout title="가치로운이란?">
  <div class="page-container">

    <!-- 가치란 -->
    <section id="values" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title clickable-title">가치란</h2>
        
        <div class="value-content">
          <div class="value-image">
            <img src="/images/about-gachi.png" alt="가치로운 로고 의미" />
          </div>
          
          <div class="logo-description simple-card">
            <p class="logo-text">
              '가치로운'의 초성 <span class="highlight-bold-orange">'ㄱ'</span>과 <span class="highlight-bold-yellow">'ㅊ'</span>을 사람 형상으로 표현하여 <strong class="highlight-bold-orange">'같이'</strong>의 의미를 담았으며, 이는 이용자·지역사회·우리 이웃들과의 <strong class="highlight-bold-orange">동행</strong>을 나타냅니다.
            </p>
            <p class="logo-text">
              <span class="highlight-bold-orange">주황</span>은 열정, <span class="highlight-bold-yellow">노랑</span>은 희망과 즐거움을 상징합니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 사회적협동조합이란 -->
    <section id="cooperative" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">사회적협동조합이란</h2>
        <div class="cooperative-content">
          <h3>사회적협동조합 설립의 필요성</h3>
          <ul class="simple-list">
            <li>공신력을 가진 법인으로서의 활동 가능</li>
            <li>정기적인 정보공시를 통해 공익성과 회계의 투명성 확보</li>
            <li>법적 후원금 관리 및 기부금영수증 발급 (후원금 금액, 사용처 공개)</li>
            <li>전문적인 회계/행정/인사/홍보/마케팅 운영 가능</li>
            <li>사회복지사 실습 지도 및 청소년 및 지역주민 자원봉사 실적 인정 가능</li>
            <li>사회적협동조합 폐업 시 모든 재산은 국가에게 환수</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 인사말 -->
    <section id="greeting" class="content-section bg-light" data-strapi-path="single-types > about > greeting">
      <div class="container">
        <h2 class="section-title clickable-title">인사말</h2>
            <div class="greeting-content">
              {greetingData && greetingData.title ? (
                <h3 data-strapi-path="single-types > about > greeting > title" id="greeting-title">{greetingData.title}</h3>
              ) : (
                <h3 data-strapi-path="single-types > about > greeting > title" id="greeting-title">"우리 같이, 가치롭게."</h3>
              )}

              {greetingData && greetingData.body ? (
                // body is now converted to HTML in strapi.ts
                <div data-strapi-path="single-types > about > greeting > body" id="greeting-body" set:html={greetingData.body} />
              ) : (
                <div data-strapi-path="single-types > about > greeting > body" id="greeting-body">
                <>
                  <p>
                    사회적협동조합 가치로운은 서로 돌보고 함께 성장하는 마음으로 시작된 공동체입니다. 
                    우리는 사람과 사람 사이의 온기를 잇고, 삶의 모든 순간에 '가치'를 더하고자 합니다.
                  </p>
                  <p>
                    작은 손길 하나, 따뜻한 말 한마디가 누군가의 하루를 바꿀 수 있다고 믿습니다. 
                    그래서 우리는 복지와 교육, 돌봄과 나눔의 현장에서 사람 중심의 변화를 만들어가고 있습니다.
                  </p>
                  <p>
                    대표와 부대표, 그리고 모든 조합원은 '같이의 가치'를 실천하며 서로의 삶에 빛이 되는 
                    여정을 함께 걷고 있습니다.
                  </p>
                  <p>
                    오늘도 누군가의 하루가 조금 더 따뜻하고, 조금 더 가치로워지길 바랍니다.
                  </p>
                </div>
              )}

              <p class="signature" data-strapi-path="single-types > about > greeting > writtenby" id="greeting-writtenby">{greetingData?.writtenby ?? '사회적협동조합 가치로운 발기인 일동'}</p>
            </div>
      </div>
    </section>

    <!-- 가치로운의 순환구조 -->
    <section id="cycle" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title clickable-title">가치로운의 순환구조</h2>
        
        <div class="cycle-content">
          <div class="cycle-image">
            <img src="/images/gachi-cycle.png" alt="가치로운 순환구조 다이어그램" />
          </div>
          <div class="cycle-description">
            <p>
              <strong class="highlight-service">어르신 재가방문요양</strong> 및 <strong class="highlight-service">장애인활동지원</strong> 사업을 통해 수익을 창출하고,
              <strong class="highlight-service">아동청소년</strong> 주도의 <strong class="highlight-service">성장지원</strong> 활동을 통해 지역사회에 환원하는
              <strong class="highlight-value">지속가능한 복지 모델</strong>을 실현하고자 합니다.
            </p>
            <p>
              어르신·장애인·청소년·지역주민이 함께 참여하는
              복지 및 성장지원 사업을 통해 <strong class="highlight-value">상생과 배려의 공동체 실현</strong>을 추구하고자 합니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 경영철학 & 비전 -->
    <section id="vision" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">경영철학 & 비전</h2>

        <div class="content-grid">
          <div class="simple-card">
            <h4>■ 경영철학 (Philosophy)</h4>
            <p class="highlight">"우리 같이 가치롭게"</p>
            <p>
              '가치로운'은 <strong>'가치'와 '같이'</strong>의 결합으로, 
              사람과 지역이 함께 성장하는 <strong>'동행의 철학'</strong>을 담고 있습니다.
            </p>
            <p>초성 ㄱ·ㅊ은 사람을 형상화하여 '함께'의 의미를 시각적으로 표현했습니다.</p>
            <p>🧡 주황 = 열정과 따뜻함, 💛 노랑 = 희망과 즐거움</p>
          </div>

          <div class="simple-card">
            <h4>■ 미션 (Mission)</h4>
            <p class="highlight">"모두가 존중받으며 성장하는 지역공동체를 만든다."</p>
            <ul>
              <li>어르신·장애인·아동청소년·지역주민이 함께 참여하고 성장하는 복지공동체</li>
              <li>복지의 '대상'이 아닌 '주체'로서 상생과 배려의 복지 순환 모델 실현</li>
            </ul>
          </div>

          <div class="simple-card">
            <h4>■ 비전 (Vision)</h4>
            <p class="highlight">"사람 중심, 가치 중심, 지역 중심의 지속가능한 복지 생태계 구축"</p>
            <p><strong>복지 순환모델 4단계</strong></p>
            <p>① 어르신 → ② 장애인 → ③ 아동·청소년 → ④ 지역주민</p>
            <p>세대와 계층이 연결되어 서로의 손을 잡고 함께 성장하는 구조를 구축합니다.</p>
          </div>

          <div class="simple-card">
            <h4>■ 핵심가치 (Core Values)</h4>
            <ul>
              <li>같이 (With) — 함께하는 동행과 참여</li>
              <li>가치 (Value) — 존중과 배려의 마음</li>
              <li>성장 (Growth) — 배움과 자립의 실현</li>
              <li>지속 (Sustainability) — 지역에 뿌리내린 복지 실천</li>
            </ul>
          </div>
        </div>

        <div class="slogan-box">
          <h4>슬로건 (Slogan)</h4>
          <p class="slogan">"우리 같이 가치롭게"</p>
          <p>함께의 힘으로, 모두의 가치를 피워냅니다.</p>
        </div>
      </div>
    </section>

    <!-- 가치로운 강남구 -->
    <section id="gangnam" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title clickable-title">가치로운 강남구</h2>
        
        <div class="content-grid">
          <div class="simple-card">
            <h4><strong>지역사회 내 장애인 인구 및 수요 증가</strong></h4>
            <ul>
              <li>강남구의 등록 장애인 수는 약 15,000명 이상으로 지속적으로 장애인 수가 증가되고 있음</li>
              <li>강남구 관내 장애인활동지원기관의 수는 서울 25개 자치구의 평균 수준으로 8개 기관 운영중</li>
            </ul>
          </div>

          <div class="simple-card">
            <h4><strong>아동·청소년 지역밀착형 서비스 제공</strong></h4>
            <ul>
              <li>대치동은 대한민국에서 학원이 가장 많이 위치한 지역으로 아동·청소년 유동인구가 가장 많은 지역임</li>
              <li>아동·청소년들의 장애인 인식개선 교육, 각종 봉사활동 참여, 역사문화 탐방 등을 통해 
                  바람직한 가치관을 형성하여 정신적·육체적으로 안정적인 성장을 지원</li>
            </ul>
          </div>

          <div class="simple-card">
            <h4><strong>어르신 복지 증가 및 사각지대 해소</strong></h4>
            <ul>
              <li>대치4동은 강남구에서도 주택 밀집 지역으로 노인·장애인의 수요가 많아 
                  노인복지관 확장 추진 및 서울시 장애인 행복플러스센터(장애인 관련 공공기관) 운영중</li>
              <li>이에 이용자 중심의 접근성 높은 서비스를 제공함으로서 사각지대 해소에 기여하고자 함</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 가치로운 접근성 -->
    <section id="access" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">가치로운 접근성</h2>
        <div class="access-content">
          <div class="access-image">
            <img src="/images/gachi-in-gangnam.png" alt="가치로운 강남구 위치" />
          </div>
          <div class="access-simple">
            <div class="access-item">
              <span class="access-icon">🚇</span>
              <span class="access-text">선릉역 1번출구 지하철 바로 연결</span>
            </div>
            <div class="access-item">
              <span class="access-icon">🚉</span>
              <span class="access-text">지하철 2호선 / 수인분당선</span>
            </div>
            <div class="access-item">
              <span class="access-icon">📍</span>
              <span class="access-text">강남구 중북부 유일한 기관</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 조직도 -->
    <section id="organization" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title clickable-title">조직도</h2>
        <div class="org-chart-multicol">
          <div class="org-col">
            <div class="org-title">총회</div>
            <div class="org-group">
              <div class="org-item">감사</div>
              <div class="org-item">이사회
                <div class="org-subgroup">
                  <div class="org-item">이사장</div>
                  <div class="org-item">부이사장</div>
                </div>
              </div>
              <div class="org-item">위원회
                <div class="org-subgroup">
                  <div class="org-item">운영위원회</div>
                  <div class="org-item">인사위원회</div>
                  <div class="org-item">인권위원회</div>
                  <div class="org-item">고충처리위원회</div>
                </div>
              </div>
            </div>
          </div>
          <div class="org-col">
            <div class="org-title">사업본부</div>
            <div class="org-group">
              <div class="org-item">재가방문요양사업본부
                <div class="org-subgroup">
                  <div class="org-item">본부장</div>
                  <div class="org-item">사회복지사</div>
                  <div class="org-item">요양보호사</div>
                </div>
              </div>
              <div class="org-item">장애인활동지원사업본부
                <div class="org-subgroup">
                  <div class="org-item">본부장</div>
                  <div class="org-item">사회복지사</div>
                  <div class="org-item">활동지원사</div>
                </div>
              </div>
              <div class="org-item">아동청소년성장지원사업본부
                <div class="org-subgroup">
                  <div class="org-item">본부장</div>
                  <div class="org-item">회원</div>
                  <div class="org-item">자원봉사자</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="org-notes">
          <p><strong>이사장:</strong> 협동조합 대표, 협동조합 운영 및 사업본부 슈퍼비전</p>
          <p><strong>부이사장:</strong> 지역사회 네트워크 및 사업별 예산, 인사, 실무 총괄</p>
          <p><strong>본부장:</strong> 각 본부의 사업 실무 총괄 및 사원 관리</p>
          <p><strong>사회복지사, 요양보호사, 활동지원사, 자원봉사자, 회원, 조합원</strong></p>
        </div>
      </div>
    </section>

    <!-- 연혁 -->
    <section id="history" class="content-section" data-strapi-path="collection-types > histories">
      <div class="container">
        <h2 class="section-title clickable-title">연혁</h2>
        <div class="section-content">
          
          <!-- PC 버전: 타임라인 -->
          <div class="history-timeline history-pc">
            <div class="timeline-line"></div>
            {historyData.map((item, index) => (
              <div class={`history-item ${index % 2 === 0 ? 'left' : 'right'}`} data-strapi-path={item._strapiPath}>
                {index % 2 === 0 ? (
                  <>
                    <div class="history-content">
                      <span class="history-date" data-strapi-path={item._strapiFields.date}>{item.date}</span>
                      <h4 data-strapi-path={item._strapiFields.title}>{item.title}</h4>
                      {item.description && <p data-strapi-path={item._strapiFields.description}>{item.description}</p>}
                      {item.link && (
                        <p>
                          <a href={item.link} target="_blank" rel="noopener noreferrer" data-type="external-event" data-strapi-path={item._strapiFields.link}>
                            {item.linkText || '자세히 보기'}
                          </a>
                        </p>
                      )}
                    </div>
                    <div class="timeline-dot"></div>
                  </>
                ) : (
                  <>
                    <div class="timeline-dot"></div>
                    <div class="history-content">
                      <span class="history-date" data-strapi-path={item._strapiFields.date}>{item.date}</span>
                      <h4 data-strapi-path={item._strapiFields.title}>{item.title}</h4>
                      {item.description && <p data-strapi-path={item._strapiFields.description}>{item.description}</p>}
                      {item.link && (
                        <p>
                          <a href={item.link} target="_blank" rel="noopener noreferrer" data-type="external-event" data-strapi-path={item._strapiFields.link}>
                            {item.linkText || '자세히 보기'}
                          </a>
                        </p>
                      )}
                    </div>
                  </>
                )}
              </div>
            ))}
