---
import MainLayout from '../layouts/MainLayout.astro';

// 가상 공지사항 샘플
const announcements = [
  {
    id: 1,
    title: '2025년 상반기 조합원 총회 개최 안내',
    date: '2025-01-15',
    content: '2025년 상반기 조합원 정기총회를 개최합니다. 모든 조합원님들의 참석을 부탁드립니다.'
  },
  {
    id: 2,
    title: '설 연휴 운영 안내',
    date: '2025-01-20',
    content: '설 연휴 기간(2/9~2/12) 동안 사무실 운영 시간이 변경됩니다. 긴급 연락은 비상연락처로 부탁드립니다.'
  },
  {
    id: 3,
    title: '활동지원사 보수교육 일정 안내',
    date: '2025-02-01',
    content: '2025년 상반기 활동지원사 보수교육 일정을 안내드립니다. 필수 참석 부탁드립니다.'
  },
  {
    id: 4,
    title: '신규 조합원 모집 안내',
    date: '2025-02-10',
    content: '사회적협동조합 가치로운과 함께할 신규 조합원을 모집합니다. 많은 관심 부탁드립니다.'
  }
];

// 가상 행사일정 샘플 (연혁 기반)
const events = [
  {
    id: 1,
    title: '제3회 대치4동 문화마당',
    date: '2025-09-27',
    location: '대치4동 주민센터',
    description: '지역주민과 함께하는 문화행사'
  },
  {
    id: 2,
    title: '제14회 강남구민화합축제',
    date: '2025-10-18',
    location: '강남구청 광장',
    description: '강남구민이 함께하는 화합의 축제'
  },
  {
    id: 3,
    title: '청소년 역사문화탐방',
    date: '2025-11-15',
    location: '경복궁 및 인사동 일대',
    description: '청소년 대상 역사문화 체험 프로그램'
  },
  {
    id: 4,
    title: '연말 송년의 밤',
    date: '2025-12-20',
    location: '가치로운 사무실',
    description: '조합원 및 이용자와 함께하는 송년행사'
  }
];
---

<MainLayout title="안내사항">
  <div class="page-container">
    <!-- 공지사항 -->
    <section id="announcements" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">공지사항</h2>
        <div class="board-list">
          {announcements.map((item) => (
            <div class="board-item">
              <div class="board-header">
                <h3>{item.title}</h3>
                <span class="date">{item.date}</span>
              </div>
              <p>{item.content}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 연간 주요 일정 -->
    <section id="annual-schedule" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">연간 주요 일정</h2>
        <div class="annual-schedule-grid">
          <div class="schedule-card">
            <div class="schedule-month">2월</div>
            <h3>이사회</h3>
            <p>정기 이사회가 매년 2월에 개최됩니다.</p>
          </div>
          <div class="schedule-card">
            <div class="schedule-month">3월</div>
            <h3>총회</h3>
            <p>조합원 정기총회가 매년 3월에 개최됩니다.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 행사일정 -->
    <section id="events" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title clickable-title">행사일정</h2>
        <div class="events-grid">
          {events.map((event) => (
            <div class="event-card">
              <div class="event-date">
                <span class="year">{event.date.split('-')[0]}년</span>
                <span class="month">{event.date.split('-')[1]}월</span>
                <span class="day">{event.date.split('-')[2]}일</span>
              </div>
              <h3>{event.title}</h3>
              <p class="location">📍 {event.location}</p>
              <p class="description">{event.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 봉사활동 신청 -->
    <section id="volunteer" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">봉사활동 신청</h2>
        <div class="form-intro">
          <p>
            가치로운과 함께 지역사회에 따뜻한 변화를 만들어가실 봉사자를 모집합니다.<br />
            청소년, 대학생, 일반인 모두 참여 가능하며, 봉사활동 실적 인정이 가능합니다.
          </p>
        </div>

        <div class="form-container">
          <div class="form-info">
            <h3>봉사활동 안내</h3>
            <ul>
              <li><strong>활동 내용:</strong> 어르신 말벗 서비스, 청소년 멘토링, 환경정화 활동 등</li>
              <li><strong>활동 시간:</strong> 주 1회 2시간 이상 (협의 가능)</li>
              <li><strong>자격:</strong> 봉사활동에 관심 있는 누구나</li>
              <li><strong>혜택:</strong> 봉사활동 실적 인정, 봉사활동 확인서 발급</li>
            </ul>
          </div>

          <div class="google-form-notice">
            <p>📝 봉사활동 신청은 구글폼으로 진행됩니다</p>
            <a href="#" class="btn-primary" onclick="alert('구글폼 링크가 준비중입니다.'); return false;">
              신청서 작성하기
            </a>
            <p class="form-note">* 신청서 작성 후 담당자가 개별 연락드립니다.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 정기후원 신청 -->
    <section id="donation" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title clickable-title">정기후원 신청</h2>
        <div class="form-intro">
          <p>
            사회적협동조합 가치로운은 여러분의 소중한 후원으로 운영됩니다.<br />
            정기후원을 통해 지역사회의 취약계층에게 따뜻한 손길을 전해주세요.
          </p>
        </div>

        <div class="donation-benefits">
          <h3>후원 혜택</h3>
          <div class="benefits-grid">
            <div class="benefit-card">
              <span class="benefit-icon">📄</span>
              <h4>기부금영수증 발급</h4>
              <p>연말정산 시 세액공제 혜택</p>
            </div>
            <div class="benefit-card">
              <span class="benefit-icon">📧</span>
              <h4>활동 소식 발송</h4>
              <p>정기 뉴스레터 및 활동보고서</p>
            </div>
            <div class="benefit-card">
              <span class="benefit-icon">🎁</span>
              <h4>후원자 초청행사</h4>
              <p>연 1회 후원자 감사행사</p>
            </div>
          </div>
        </div>

        <div class="form-container">
          <div class="form-info">
            <h3>후원 안내</h3>
            <ul>
              <li><strong>후원 방법:</strong> 정기후원 (월 1만원 이상) 또는 일시후원</li>
              <li><strong>후원 계좌:</strong> 신한은행 000-000-000000 (사회적협동조합 가치로운)</li>
              <li><strong>기부금 영수증:</strong> 신청 시 자동 발급</li>
              <li><strong>후원금 사용:</strong> 홈페이지를 통해 투명하게 공개</li>
            </ul>
          </div>

          <div class="google-form-notice">
            <p>📝 정기후원 신청은 구글폼으로 진행됩니다</p>
            <a href="#" class="btn-primary" onclick="alert('구글폼 링크가 준비중입니다.'); return false;">
              후원 신청하기
            </a>
            <p class="form-note">* 신청서 작성 후 담당자가 개별 연락드립니다.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .page-container {
    width: 100%;
  }

  .content-section {
    padding: var(--spacing-4xl) 0;
    scroll-margin-top: 80px;
  }

  .content-section.bg-light {
    background-color: var(--color-bg-light);
  }

  /* 공지사항 게시판 */
  .board-list {
    margin-top: var(--spacing-2xl);
  }

  .board-item {
    background: var(--color-gray-50);
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-lg);
    border-top: 3px solid var(--color-primary-500);
    transition: transform 0.2s ease;
  }

  .board-item:hover {
    transform: translateY(-2px);
  }

  .board-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
  }

  .board-header h3 {
    color: var(--color-primary-700);
    font-size: 1.2rem;
  }
  
  .board-header h3::before {
    content: '📢 ';
    font-size: 0.5em;
    margin-right: 0.5em;
    vertical-align: middle;
  }

  .board-header .date {
    color: var(--color-gray-500);
  }
  
  .board-header .date::before {
    content: '📅 ';
    font-size: 0.6em;
    margin-right: 0.4em;
    vertical-align: middle;
  }

  .board-item p {
    color: var(--color-gray-700);
    line-height: 1.6;
  }

  /* 연간 주요 일정 */
  .annual-schedule-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-2xl);
  }

  .schedule-card {
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-top: 3px solid var(--color-primary-500);
    transition: all 0.3s ease;
  }

  .schedule-card:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .schedule-month {
    color: var(--color-primary-500);
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: var(--spacing-md);
  }
  
  .schedule-month::before {
    content: '📅 ';
    font-size: 0.5em;
    top: 0.8em;
    margin-right: 0.3em;
  }

  .schedule-content h3 {
    color: var(--color-gray-900);
    font-size: 1.3rem;
    margin-bottom: var(--spacing-sm);
    font-weight: 700;
  }

  .schedule-content p {
    color: var(--color-gray-600);
    line-height: 1.7;
  }

  /* 행사일정 */
  .events-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-2xl);
  }

  .event-card {
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-top: 3px solid var(--color-primary-500);
    transition: all 0.3s ease;
  }

  .event-card:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .event-date {
    color: var(--color-primary-500);
    font-weight: 700;
    margin-bottom: var(--spacing-md);
    display: flex;
    gap: var(--spacing-sm);
    align-items: baseline;
  }
  
  .event-date::before {
    content: '📅 ';
    font-size: 0.6em;
    margin-right: 0.2em;
    align-self: center;
  }

  .event-date .year {
    font-size: 0.875rem;
  }

  .event-date .month,
  .event-date .day {
    font-size: 1.125rem;
  }

  .event-content h3 {
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .event-content .location {
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-sm);
    font-size: 0.95rem;
  }

  .event-content .description {
    color: var(--color-gray-700);
    line-height: 1.7;
  }

  /* 폼 섹션 */
  .form-intro {
    text-align: center;
    max-width: 800px;
    margin: var(--spacing-2xl) auto;
    padding: var(--spacing-lg) var(--spacing-xl);
    background: var(--color-accent-50);
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-accent-500);
  }

  .form-intro p {
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .form-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-3xl);
    margin-top: var(--spacing-3xl);
  }

  .form-info {
    background: var(--color-gray-50);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-primary-500);
    transition: all 0.3s ease;
  }
  
  .form-info:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .form-info h3 {
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-lg);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .form-info ul {
    list-style: none;
    padding: 0;
  }

  .form-info li {
    padding: var(--spacing-sm) 0 var(--spacing-sm) var(--spacing-md);
    position: relative;
  }

  .form-info li::before {
    content: '●';
    position: absolute;
    left: 0;
    font-size: 0.6em;
    top: 1.2em;
    color: var(--color-primary-500);
  }

  .form-info strong {
    color: var(--color-primary-500);
    font-weight: 600;
  }

  .google-form-notice {
    background: var(--color-gray-50);
    padding: var(--spacing-2xl);
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-accent-500);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .google-form-notice p {
    font-size: 1.1rem;
    margin-bottom: var(--spacing-xl);
    color: var(--color-gray-700);
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-primary-600);
    color: white;
    padding: var(--spacing-md) var(--spacing-3xl);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: bold;
    font-size: 1.1rem;
    transition: background 0.3s;
  }

  .btn-primary:hover {
    background: var(--color-primary-700);
  }

  .form-note {
    font-size: 0.9rem;
    color: var(--color-gray-500);
    margin-top: var(--spacing-lg);
  }

  /* 후원 혜택 */
  .donation-benefits {
    margin: var(--spacing-3xl) 0;
  }

  .donation-benefits h3 {
    text-align: center;
    color: var(--color-primary-600);
    margin-bottom: var(--spacing-2xl);
    font-size: 1.6rem;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-2xl);
  }

  .benefit-card {
    background: var(--color-gray-50);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-primary-500);
    text-align: center;
    transition: all 0.3s ease;
  }

  .benefit-card:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .benefit-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: var(--spacing-md);
  }

  .benefit-card h4 {
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .benefit-card p {
    color: var(--color-gray-600);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .events-grid,
    .form-container,
    .benefits-grid,
    .annual-schedule-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) and (min-width: 481px) {
    /* 태블릿: 멀티컬럼 유지 */
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .board-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .board-header .date {
      margin-top: var(--spacing-xs);
    }

    .board-item,
    .schedule-card,
    .event-card,
    .form-info,
    .google-form-notice,
    .benefit-card {
      padding: var(--spacing-sm) var(--spacing-md);
      border-top-width: 2px;
    }
  }
</style>

<script>
  // Smooth scroll for hashbang navigation
  document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash;
    if (hash) {
      setTimeout(() => {
        const element = document.querySelector(hash);
        if (element) {
          element.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 100);
    }
  });

  // Track hashbang navigation
  window.addEventListener('hashchange', () => {
    if (typeof window.gtag !== 'undefined') {
      window.gtag('config', 'GTM-MVL6P7N7', {
        page_path: window.location.pathname + window.location.hash
      });
    }
  });

  // Dynamic title
  const sectionTitles: Record<string, string> = {
    'announcements': '공지사항',
    'annual-schedule': '연간 주요 일정',
    'events': '행사 일정',
    'volunteer': '봉사활동 신청',
    'donation': '정기후원 신청'
  };

  function updateTitle() {
    const hash = window.location.hash.replace('#', '') || 'announcements';
    const sectionTitle = sectionTitles[hash] || '공지사항';
    document.title = `안내사항 > ${sectionTitle} | 사회적협동조합 가치로운`;
  }

  window.addEventListener('hashchange', updateTitle);
  
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const sections = document.querySelectorAll('section[id]');
        let currentSection = 'announcements';
        let closestDistance = Infinity;
        
        sections.forEach(section => {
          const rect = section.getBoundingClientRect();
          const distance = Math.abs(rect.top - 150);
          
          // 섹션이 뷰포트 안에 있고, 기준점(150px)에 가장 가까운 섹션 선택
          if (rect.top <= 150 && rect.bottom >= 150 && distance < closestDistance) {
            currentSection = section.id;
            closestDistance = distance;
          }
        });
        
        const newHash = '#' + currentSection;
        if (window.location.hash !== newHash) {
          history.replaceState(null, '', newHash);
          updateTitle();
        }
        
        ticking = false;
      });
      ticking = true;
    }
  });

  document.addEventListener('DOMContentLoaded', updateTitle);
  updateTitle();
</script>
