---
import MainLayout from '../layouts/MainLayout.astro';
import strapiClient from '../lib/strapi';
import CommandPalette from '../components/react/CommandPalette';
import { getEnv } from '../lib/env';

// 환경 변수 공통 헬퍼 사용
const env = getEnv(Astro.locals);

// Strapi API: announcements (collection type) - fields: title, body, photo, createdAt
const announcements = await (async () => {
  try {
    console.log('[SSR] Fetching announcements...');

    // Check if required environment variables are set
    if (!env.STRAPI_URL) {
      throw new Error('STRAPI_URL environment variable is not set. Please configure it in Cloudflare Pages settings.');
    }

    if (!env.STRAPI_API_TOKEN_FULL && !env.STRAPI_API_TOKEN_READ && !env.STRAPI_API_TOKEN) {
      throw new Error('No Strapi API token found. Please configure Strapi token.');
    }

    const data = await strapiClient.getAnnouncements(10, env);
    console.log('[SSR] Fetched', data?.length || 0, 'announcements');
    return data;
  } catch (e) {
    console.error('[SSR Debug] Failed to load announcements from Strapi:', e);
    console.error('[SSR Debug] Error details:', {
      message: e.message,
      stack: e.stack,
      name: e.name
    });

    // Store error info for client-side debugging
    globalThis.strapiError = {
      message: e.message,
      stack: e.stack,
      timestamp: new Date().toISOString(),
      url: env.STRAPI_URL,
      hasToken: !!(env.STRAPI_API_TOKEN_FULL || env.STRAPI_API_TOKEN_READ || env.STRAPI_API_TOKEN),
      envVars: {
        STRAPI_URL: env.STRAPI_URL,
        STRAPI_API_TOKEN_FULL: env.STRAPI_API_TOKEN_FULL ? 'SET' : 'NOT_SET',
        STRAPI_API_TOKEN_READ: env.STRAPI_API_TOKEN_READ ? 'SET' : 'NOT_SET',
        STRAPI_API_TOKEN: env.STRAPI_API_TOKEN ? 'SET' : 'NOT_SET'
      }
    };

    return [];
  }
})();

// 가상 행사일정 샘플 (연혁 기반)
const events = [
  {
    id: 1,
    title: '제3회 대치4동 문화마당',
    date: '2025-09-27',
    location: '대치4동 주민센터',
    description: '지역주민과 함께하는 문화행사'
  },
  {
    id: 2,
    title: '제14회 강남구민화합축제',
    date: '2025-10-18',
    location: '강남구청 광장',
    description: '강남구민이 함께하는 화합의 축제'
  },
  {
    id: 3,
    title: '청소년 역사문화탐방',
    date: '2025-11-15',
    location: '경복궁 및 인사동 일대',
    description: '청소년 대상 역사문화 체험 프로그램'
  },
  {
    id: 4,
    title: '연말 송년의 밤',
    date: '2025-12-20',
    location: '가치로운 사무실',
    description: '조합원 및 이용자와 함께하는 송년행사'
  }
];
---

<MainLayout title="안내사항" data-strapi-url={env.STRAPI_URL || 'http://localhost:1337'}>
  <div class="page-container">
    <!-- 공지사항 -->
    <section id="announcements" class="content-section" data-strapi-path="collection-types > notices">
      <div class="container">
        <h2 class="section-title clickable-title">공지사항</h2>
        <div class="board-list" id="announcement-list">
          {announcements.length > 0 ? announcements.map((item: any) => (
            <div class="board-item" data-strapi-path={`collection-types > notices > ${item.id}`}>
              <div class="board-content-wrapper">
                <div class="board-text">
                  <div class="board-header">
                    <h3 class="announcement-title" data-strapi-path={`collection-types > notices > ${item.id} > title`} data-id={item.id}>{item.title}</h3>
                    <span class="date" data-strapi-path={`collection-types > notices > ${item.id} > createdAt`}>{new Date(item.createdAt).toLocaleDateString('ko-KR')}</span>
                  </div>
                  <div class="board-preview" data-strapi-path={`collection-types > notices > ${item.id} > body`}>
                    {item.body.replace(/<[^>]*>/g, '').substring(0, 100)}...
                  </div>
                  <button class="btn-view-more" data-id={item.id} data-title={item.title} data-body={item.body} data-photo={item.photo || ''} data-photo-alt={item.photoAlt || ''}>
                    자세히 보기 →
                  </button>
                </div>
                {item.photo && (
                  <div class="board-thumbnail">
                    <img src={item.photo.startsWith('http') ? item.photo : `${env.STRAPI_URL}${item.photo}`} alt={item.photoAlt || item.title} />
                  </div>
                )}
              </div>
            </div>
          )) : (
            <div class="no-announcements">
              <p>등록된 공지사항이 없습니다.</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- 연간 주요 일정 -->
    <section id="annual-schedule" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">연간 주요 일정</h2>
        <div class="annual-schedule-grid">
          <div class="schedule-card">
            <div class="schedule-month">2월</div>
            <h3>이사회</h3>
            <p>정기 이사회가 매년 2월에 개최됩니다.</p>
          </div>
          <div class="schedule-card">
            <div class="schedule-month">3월</div>
            <h3>총회</h3>
            <p>조합원 정기총회가 매년 3월에 개최됩니다.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 행사일정 -->
    <section id="events" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title clickable-title">행사일정</h2>
        <div class="events-grid">
          {events.map((event) => (
            <div class="event-card">
              <div class="event-date">
                <span class="year">{event.date.split('-')[0]}년</span>
                <span class="month">{event.date.split('-')[1]}월</span>
                <span class="day">{event.date.split('-')[2]}일</span>
              </div>
              <h3>{event.title}</h3>
              <p class="location">📍 {event.location}</p>
              <p class="description">{event.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 봉사활동 신청 -->
    <section id="volunteer" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">봉사활동 신청</h2>
        <div class="form-intro">
          <p>
            가치로운과 함께 지역사회에 따뜻한 변화를 만들어가실 봉사자를 모집합니다.<br />
            청소년, 대학생, 일반인 모두 참여 가능하며, 봉사활동 실적 인정이 가능합니다.
          </p>
        </div>

        <div class="form-container">
          <div class="form-info">
            <h3>봉사활동 안내</h3>
            <ul>
              <li><strong>활동 내용:</strong> 어르신 말벗 서비스, 청소년 멘토링, 환경정화 활동 등</li>
              <li><strong>활동 시간:</strong> 주 1회 2시간 이상 (협의 가능)</li>
              <li><strong>자격:</strong> 봉사활동에 관심 있는 누구나</li>
              <li><strong>혜택:</strong> 봉사활동 실적 인정, 봉사활동 확인서 발급</li>
            </ul>
          </div>

          <div class="google-form-notice">
            <p>📝 봉사활동 신청은 구글폼으로 진행됩니다</p>
            <a href="#" class="btn-primary" onclick="alert('구글폼 링크가 준비중입니다.'); return false;">
              신청서 작성하기
            </a>
            <p class="form-note">* 신청서 작성 후 담당자가 개별 연락드립니다.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 정기후원 신청 -->
    <section id="donation" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title clickable-title">정기후원 신청</h2>
        <div class="form-intro">
          <p>
            사회적협동조합 가치로운은 여러분의 소중한 후원으로 운영됩니다.<br />
            정기후원을 통해 지역사회의 취약계층에게 따뜻한 손길을 전해주세요.
          </p>
        </div>

        <div class="donation-benefits">
          <h3>후원 혜택</h3>
          <div class="benefits-grid">
            <div class="benefit-card">
              <span class="benefit-icon">📄</span>
              <h4>기부금영수증 발급</h4>
              <p>연말정산 시 세액공제 혜택</p>
            </div>
            <div class="benefit-card">
              <span class="benefit-icon">📧</span>
              <h4>활동 소식 발송</h4>
              <p>정기 뉴스레터 및 활동보고서</p>
            </div>
            <div class="benefit-card">
              <span class="benefit-icon">🎁</span>
              <h4>후원자 초청행사</h4>
              <p>연 1회 후원자 감사행사</p>
            </div>
          </div>
        </div>

        <div class="form-container">
          <div class="form-info">
            <h3>후원 안내</h3>
            <ul>
              <li><strong>후원 방법:</strong> 정기후원 (월 1만원 이상) 또는 일시후원</li>
              <li><strong>후원 계좌:</strong> 우리은행 1005-404-837973 사회적협동조합 가치로운</li>
              <li><strong>기부금 영수증:</strong> 신청 시 자동 발급</li>
              <li><strong>후원금 사용:</strong> 홈페이지를 통해 투명하게 공개</li>
            </ul>
          </div>

          <div class="google-form-notice">
            <p>📝 정기후원 신청은 구글폼으로 진행됩니다</p>
            <a href="#" class="btn-primary" onclick="alert('구글폼 링크가 준비중입니다.'); return false;">
              후원 신청하기
            </a>
            <p class="form-note">* 신청서 작성 후 담당자가 개별 연락드립니다.</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Command Palette for Admin Tools -->
  <CommandPalette client:load />
</MainLayout>

<style>
  .page-container {
    width: 100%;
  }

  .content-section {
    padding: var(--spacing-4xl) 0;
    scroll-margin-top: 80px;
  }

  .content-section.bg-light {
    background-color: var(--color-bg-light);
  }

  /* 공지사항 게시판 */
  .board-list {
    margin-top: var(--spacing-2xl);
  }

  .board-item {
    background: var(--color-gray-50);
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-lg);
    border-top: 3px solid var(--color-primary-500);
    transition: transform 0.2s ease;
  }

  .board-item:hover {
    transform: translateY(-2px);
  }

  .board-content-wrapper {
    display: flex;
    gap: var(--spacing-lg);
    align-items: flex-start;
  }

  .board-text {
    flex: 1;
  }

  .board-thumbnail {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-gray-200);
  }

  .board-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .board-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
  }

  .board-header h3 {
    color: var(--color-primary-700);
    font-size: 1.2rem;
    cursor: pointer;
    transition: color 0.2s;
  }

  .board-header h3:hover {
    color: var(--color-accent-600);
  }
  
  .board-header h3::before {
    content: '📢 ';
    font-size: 0.5em;
    margin-right: 0.5em;
    vertical-align: middle;
  }

  .board-preview {
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
    text-align: justify;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .btn-view-more {
    background: linear-gradient(135deg, var(--color-primary-500), var(--color-accent-500));
    color: white;
    border: none;
    padding: var(--spacing-sm) var(--spacing-lg);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-view-more:hover {
    transform: translateX(4px);
    box-shadow: 0 4px 12px rgba(242, 101, 56, 0.3);
  }

  @media (max-width: 480px) {
    .board-content-wrapper {
      flex-direction: column;
    }

    .board-thumbnail {
      width: 100%;
      height: 180px;
    }
  }

  /* Modal Styles - Global to work with dynamically inserted HTML */
  :global(.modal-overlay) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 1rem;
    backdrop-filter: blur(4px);
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  :global(.modal-container) {
    background: white;
    border-radius: 16px;
    max-width: 800px;
    width: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: slideUp 0.3s ease-out;
    overflow: hidden;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(.modal-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid #e5e7eb;
    background: linear-gradient(to right, var(--color-primary-50), var(--color-accent-50));
  }

  :global(.modal-title) {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gray-900);
  }

  :global(.modal-share),
  :global(.modal-close) {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--color-gray-500);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: all 0.2s;
    padding: 0;
    line-height: 1;
  }

  :global(.modal-close) {
    font-size: 1.75rem;
  }

  :global(.modal-share:hover),
  :global(.modal-close:hover) {
    background: rgba(0, 0, 0, 0.05);
    color: var(--color-gray-900);
    transform: scale(1.1);
  }

  :global(.modal-share:hover) {
    color: var(--color-primary-600);
  }

  :global(.modal-body) {
    padding: 2rem;
    overflow-y: auto;
    flex: 1;
    line-height: 1.7;
  }

  :global(.modal-body p) {
    margin-bottom: 1rem;
    color: var(--color-gray-700);
  }

  :global(.modal-body strong) {
    color: var(--color-gray-900);
    font-weight: 600;
  }

  .board-header .date {
    color: var(--color-gray-500);
  }
  
  .board-header .date::before {
    content: '📅 ';
    font-size: 0.6em;
    margin-right: 0.4em;
    vertical-align: middle;
  }

  .board-item p {
    color: var(--color-gray-700);
    line-height: 1.6;
  }

  .board-image {
    margin: var(--spacing-md) 0;
    text-align: center;
  }

  .board-image img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .board-content {
    color: var(--color-gray-700);
    line-height: 1.6;
  }

  .board-content p {
    margin-bottom: var(--spacing-md);
  }

  .board-content p:last-child {
    margin-bottom: 0;
  }

  .no-announcements {
    text-align: center;
    padding: var(--spacing-2xl);
    color: var(--color-gray-500);
  }

  .no-announcements p {
    font-size: 1.1rem;
  }

  /* 연간 주요 일정 */
  .annual-schedule-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-2xl);
  }

  .schedule-card {
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-top: 3px solid var(--color-primary-500);
    transition: all 0.3s ease;
  }

  .schedule-card:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .schedule-month {
    color: var(--color-primary-500);
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: var(--spacing-md);
  }
  
  .schedule-month::before {
    content: '📅 ';
    font-size: 0.5em;
    top: 0.8em;
    margin-right: 0.3em;
  }

  .schedule-content h3 {
    color: var(--color-gray-900);
    font-size: 1.3rem;
    margin-bottom: var(--spacing-sm);
    font-weight: 700;
  }

  .schedule-content p {
    color: var(--color-gray-600);
    line-height: 1.7;
  }

  /* 행사일정 */
  .events-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-2xl);
  }

  .event-card {
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-top: 3px solid var(--color-primary-500);
    transition: all 0.3s ease;
  }

  .event-card:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .event-date {
    color: var(--color-primary-500);
    font-weight: 700;
    margin-bottom: var(--spacing-md);
    display: flex;
    gap: var(--spacing-sm);
    align-items: baseline;
  }
  
  .event-date::before {
    content: '📅 ';
    font-size: 0.6em;
    margin-right: 0.2em;
    align-self: center;
  }

  .event-date .year {
    font-size: 0.875rem;
  }

  .event-date .month,
  .event-date .day {
    font-size: 1.125rem;
  }

  .event-content h3 {
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .event-content .location {
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-sm);
    font-size: 0.95rem;
  }

  .event-content .description {
    color: var(--color-gray-700);
    line-height: 1.7;
  }

  /* 폼 섹션 */
  .form-intro {
    text-align: center;
    max-width: 800px;
    margin: var(--spacing-2xl) auto;
    padding: var(--spacing-lg) var(--spacing-xl);
    background: var(--color-accent-50);
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-accent-500);
  }

  .form-intro p {
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .form-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-3xl);
    margin-top: var(--spacing-3xl);
  }

  .form-info {
    background: var(--color-gray-50);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-primary-500);
    transition: all 0.3s ease;
  }
  
  .form-info:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .form-info h3 {
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-lg);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .form-info ul {
    list-style: none;
    padding: 0;
  }

  .form-info li {
    padding: var(--spacing-sm) 0 var(--spacing-sm) var(--spacing-md);
    position: relative;
  }

  .form-info li::before {
    content: '●';
    position: absolute;
    left: 0;
    font-size: 0.6em;
    top: 1.2em;
    color: var(--color-primary-500);
  }

  .form-info strong {
    color: var(--color-primary-500);
    font-weight: 600;
  }

  .google-form-notice {
    background: var(--color-gray-50);
    padding: var(--spacing-2xl);
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-accent-500);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .google-form-notice p {
    font-size: 1.1rem;
    margin-bottom: var(--spacing-xl);
    color: var(--color-gray-700);
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-primary-600);
    color: white;
    padding: var(--spacing-md) var(--spacing-3xl);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: bold;
    font-size: 1.1rem;
    transition: background 0.3s;
  }

  .btn-primary:hover {
    background: var(--color-primary-700);
  }

  .form-note {
    font-size: 0.9rem;
    color: var(--color-gray-500);
    margin-top: var(--spacing-lg);
  }

  /* 후원 혜택 */
  .donation-benefits {
    margin: var(--spacing-3xl) 0;
  }

  .donation-benefits h3 {
    text-align: center;
    color: var(--color-primary-600);
    margin-bottom: var(--spacing-2xl);
    font-size: 1.6rem;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-2xl);
  }

  .benefit-card {
    background: var(--color-gray-50);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-primary-500);
    text-align: center;
    transition: all 0.3s ease;
  }

  .benefit-card:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .benefit-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: var(--spacing-md);
  }

  .benefit-card h4 {
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .benefit-card p {
    color: var(--color-gray-600);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .events-grid,
    .form-container,
    .benefits-grid,
    .annual-schedule-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) and (min-width: 481px) {
    /* 태블릿: 멀티컬럼 유지 */
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .board-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .board-header .date {
      margin-top: var(--spacing-xs);
    }

    .board-item,
    .schedule-card,
    .event-card,
    .form-info,
    .google-form-notice,
    .benefit-card {
      padding: var(--spacing-sm) var(--spacing-md);
      border-top-width: 2px;
    }
  }
</style>

<script>
  // Smooth scroll for hashbang navigation
  document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash;
    if (hash) {
      setTimeout(() => {
        const element = document.querySelector(hash);
        if (element) {
          element.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 100);
    }
  });

  // Track hashbang navigation
  window.addEventListener('hashchange', () => {
    if (typeof window.gtag !== 'undefined') {
      window.gtag('config', 'GTM-MVL6P7N7', {
        page_path: window.location.pathname + window.location.hash
      });
    }
  });

  // Dynamic title
  const sectionTitles: Record<string, string> = {
    'announcements': '공지사항',
    'annual-schedule': '연간 주요 일정',
    'events': '행사 일정',
    'volunteer': '봉사활동 신청',
    'donation': '정기후원 신청'
  };

  function updateTitle() {
    const hash = window.location.hash.replace('#', '') || 'announcements';
    const sectionTitle = sectionTitles[hash] || '공지사항';
    document.title = `안내사항 > ${sectionTitle} | 사회적협동조합 가치로운`;
  }

  window.addEventListener('hashchange', updateTitle);
  
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const sections = document.querySelectorAll('section[id]');
        let currentSection = 'announcements';
        let closestDistance = Infinity;
        
        sections.forEach(section => {
          const rect = section.getBoundingClientRect();
          const distance = Math.abs(rect.top - 150);
          
          // 섹션이 뷰포트 안에 있고, 기준점(150px)에 가장 가까운 섹션 선택
          if (rect.top <= 150 && rect.bottom >= 150 && distance < closestDistance) {
            currentSection = section.id;
            closestDistance = distance;
          }
        });
        
        const newHash = '#' + currentSection;
        if (window.location.hash !== newHash) {
          history.replaceState(null, '', newHash);
          updateTitle();
        }
        
        ticking = false;
      });
      ticking = true;
    }
  });

  document.addEventListener('DOMContentLoaded', updateTitle);
  updateTitle();

  // Modal functionality
  let currentModalData: any = null;

  const STRAPI_URL_CLIENT = document.documentElement.dataset.strapiUrl || 'http://localhost:1337';

  function openModal(title: string, body: string, photo: string, noticeId?: string) {
    const modalHTML = `
      <div class="modal-overlay" id="announcement-modal">
        <div class="modal-container">
          <div class="modal-header">
            <h2 class="modal-title">${title}</h2>
            <div style="display: flex; gap: 0.5rem;">
              <button class="modal-share" aria-label="공유하기" title="공유하기">🔗</button>
              <button class="modal-close" aria-label="닫기">✕</button>
            </div>
          </div>
          <div class="modal-body">
            ${photo ? `<img src="${photo.startsWith('http') ? photo : STRAPI_URL_CLIENT + photo}" alt="${title}" style="max-width: 100%; height: auto; border-radius: 8px; margin-bottom: 1.5rem;" />` : ''}
            ${body}
          </div>
        </div>
      </div>
    `;

    document.body.insertAdjacentHTML('beforeend', modalHTML);
    document.body.style.overflow = 'hidden';

    // URL 라우팅: hash 업데이트
    if (noticeId) {
      window.history.pushState(null, '', `#notice-${noticeId}`);
    }

    const modal = document.getElementById('announcement-modal');
    const closeBtn = modal?.querySelector('.modal-close');
    const shareBtn = modal?.querySelector('.modal-share');
    const overlay = modal; // modal element itself is the overlay

    closeBtn?.addEventListener('click', closeModal);
    shareBtn?.addEventListener('click', () => shareNotice(title, noticeId));
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });

    document.addEventListener('keydown', handleEscape);
  }

  async function shareNotice(title: string, noticeId?: string) {
    const url = noticeId ? `${window.location.origin}${window.location.pathname}#notice-${noticeId}` : window.location.href;
    
    try {
      // Web Share API 지원 확인
      if (navigator.share) {
        await navigator.share({
          title: title,
          text: `사회적협동조합 가치로운 - ${title}`,
          url: url
        });
        showToast('✅ 공유되었습니다!');
      } else {
        // Fallback: 클립보드 복사
        await navigator.clipboard.writeText(url);
        showToast('✅ 링크가 클립보드에 복사되었습니다!');
      }
    } catch (error) {
      console.error('Share failed:', error);
      // 최종 fallback: 수동 선택
      const input = document.createElement('input');
      input.value = url;
      document.body.appendChild(input);
      input.select();
      document.execCommand('copy');
      document.body.removeChild(input);
      showToast('✅ 링크가 클립보드에 복사되었습니다!');
    }
  }

  function closeModal() {
    const modal = document.getElementById('announcement-modal');
    if (modal) {
      modal.remove();
      document.body.style.overflow = 'unset';
      document.removeEventListener('keydown', handleEscape);
      
      // URL hash 제거 (notice 관련 hash만)
      if (window.location.hash.startsWith('#notice-')) {
        window.history.pushState(null, '', window.location.pathname + '#announcements');
      }
    }
  }

  function handleEscape(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      closeModal();
    }
  }

  // Attach event listeners to "자세히 보기" buttons
  document.addEventListener('DOMContentLoaded', () => {
    // Modal 중복 방지 플래그
    function isModalOpen() {
      return !!document.getElementById('announcement-modal');
    }

    // 자세히 보기 버튼 클릭 시
    const viewMoreButtons = document.querySelectorAll('.btn-view-more');
    viewMoreButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isModalOpen()) return;
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id || '';
        const title = target.dataset.title || '';
        const body = target.dataset.body || '';
        const photo = target.dataset.photo || '';
        openModal(title, body, photo, id);
      });
    });

    // 제목 클릭 시 (버튼 클릭 트리거)
    const titles = document.querySelectorAll('.announcement-title');
    titles.forEach(title => {
      title.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isModalOpen()) return;
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        const btn = document.querySelector(`.btn-view-more[data-id="${id}"]`) as HTMLElement;
        if (btn) {
          btn.click();
        }
      });
    });

    // board-item 전체 클릭 시 (내부 버튼/제목 클릭 제외)
    const boardItems = document.querySelectorAll('.board-item');
    boardItems.forEach(item => {
      item.addEventListener('click', (e) => {
        // 내부에서 이미 처리된 경우 무시
        if (isModalOpen()) return;
        // 버튼/제목 클릭 시에는 이 이벤트가 실행되지 않도록 위에서 stopPropagation 처리
        const target = item;
        const title = target.querySelector('.announcement-title')?.textContent || '';
        const btn = target.querySelector('.btn-view-more') as HTMLElement | null;
        const id = btn?.dataset.id || '';
        const body = btn?.dataset.body || '';
        const photo = btn?.dataset.photo || '';
        openModal(title, body, photo, id);
      });
    });

    // URL hash로 직접 접근 시 모달 자동 열기
    checkHashAndOpenModal();
  });

  function checkHashAndOpenModal() {
    const hash = window.location.hash;
    if (hash.startsWith('#notice-')) {
      const noticeId = hash.replace('#notice-', '');
      const btn = document.querySelector(`.btn-view-more[data-id="${noticeId}"]`) as HTMLElement;
      if (btn) {
        const title = btn.dataset.title || '';
        const body = btn.dataset.body || '';
        const photo = btn.dataset.photo || '';
        openModal(title, body, photo, noticeId);
      }
    }
  }

  // Hash 변경 시 모달 열기
  window.addEventListener('hashchange', checkHashAndOpenModal);

  // Admin tools: Announcements refetch
  // Listen for command palette actions
  window.addEventListener('message', (e) => {
    if (e.data?.type === 'refetch-announcements') {
      refetchAnnouncements();
    }
  });

  async function refetchAnnouncements() {
    try {
      console.log('[Admin] Refetching announcements data...');
      const response = await fetch('/api/announcements');
      
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const data = await response.json();
      console.log('[Admin] Received announcements data:', data);

      // Update DOM elements
      const boardList = document.querySelector('.board-list');
      if (!boardList || !Array.isArray(data)) return;

      // Clear existing items
      boardList.innerHTML = '';

      if (data.length === 0) {
        boardList.innerHTML = '<div class="no-announcements"><p>등록된 공지사항이 없습니다.</p></div>';
        return;
      }

      // Add new items (원본 HTML 구조와 동일하게 유지)
      data.forEach((item: any) => {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'board-item';
        itemDiv.setAttribute('data-strapi-path', `collection-types > notices > ${item.id}`);

        // Content wrapper (텍스트 + 썸네일)
        const wrapperDiv = document.createElement('div');
        wrapperDiv.className = 'board-content-wrapper';

        // Text section
        const textDiv = document.createElement('div');
        textDiv.className = 'board-text';

        // Board header
        const headerDiv = document.createElement('div');
        headerDiv.className = 'board-header';

        const title = document.createElement('h3');
        title.className = 'announcement-title';
        title.setAttribute('data-id', item.id);
        title.setAttribute('data-strapi-path', `collection-types > notices > ${item.id} > title`);
        title.textContent = item.title || '';

        const dateSpan = document.createElement('span');
        dateSpan.className = 'date';
        dateSpan.setAttribute('data-strapi-path', `collection-types > notices > ${item.id} > createdAt`);
        dateSpan.textContent = item.createdAt ? new Date(item.createdAt).toLocaleDateString('ko-KR') : '';

        headerDiv.appendChild(title);
        headerDiv.appendChild(dateSpan);
        textDiv.appendChild(headerDiv);

        // Board preview (100자 요약)
        const previewDiv = document.createElement('div');
        previewDiv.className = 'board-preview';
        previewDiv.setAttribute('data-strapi-path', `collection-types > notices > ${item.id} > body`);
        const plainText = (item.body || '').replace(/<[^>]*>/g, '');
        previewDiv.textContent = plainText.substring(0, 100) + '...';
        textDiv.appendChild(previewDiv);

        // View more button
        const button = document.createElement('button');
        button.className = 'btn-view-more';
        button.setAttribute('data-id', item.id);
        button.setAttribute('data-title', item.title || '');
        button.setAttribute('data-body', item.body || '');
        button.setAttribute('data-photo', item.photo || '');
        button.setAttribute('data-photo-alt', item.photoAlt || '');
        button.textContent = '자세히 보기 →';
        textDiv.appendChild(button);

        wrapperDiv.appendChild(textDiv);

        // Thumbnail (if exists)
        if (item.photo) {
          const thumbnailDiv = document.createElement('div');
          thumbnailDiv.className = 'board-thumbnail';
          
          const img = document.createElement('img');
          img.src = item.photo.startsWith('http') ? item.photo : `${STRAPI_URL_CLIENT}${item.photo}`;
          img.alt = item.photoAlt || item.title || '';
          
          thumbnailDiv.appendChild(img);
          wrapperDiv.appendChild(thumbnailDiv);
        }

        itemDiv.appendChild(wrapperDiv);
        boardList.appendChild(itemDiv);
      });

      // Show success toast
      showToast('✅ 공지사항이 성공적으로 갱신되었습니다!');
    } catch (error) {
      console.error('[Admin] Failed to refetch announcements:', error);
      showToast('❌ 공지사항 갱신 실패: ' + (error instanceof Error ? error.message : String(error)));
    }
  }

  function showToast(message: string) {
    const toast = document.createElement('div');
    toast.textContent = message;
    toast.style.cssText = `
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      padding: 1rem 1.5rem;
      background: rgba(0, 0, 0, 0.9);
      color: white;
      border-radius: 8px;
      font-size: 0.9rem;
      z-index: 10000;
      animation: fadeIn 0.3s ease;
    `;
    document.body.appendChild(toast);
    
    setTimeout(() => {
      toast.style.animation = 'fadeOut 0.3s ease';
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  // Client-side debugging for SSR errors
  if (typeof window !== 'undefined' && window.strapiError) {
    console.error('[Client Debug] Strapi SSR Error detected:', window.strapiError);
    console.error('[Client Debug] Error message:', window.strapiError.message);
    console.error('[Client Debug] Error stack:', window.strapiError.stack);
    console.error('[Client Debug] Strapi URL:', window.strapiError.url);
    console.error('[Client Debug] Has token:', window.strapiError.hasToken);
    console.error('[Client Debug] Environment variables:', window.strapiError.envVars);
    console.error('[Client Debug] Timestamp:', window.strapiError.timestamp);

    // Show user-friendly error message
    if (window.strapiError.message.includes('environment variable')) {
      console.error('[Client Debug] 🚨 환경 변수 설정 필요: Cloudflare Pages 대시보드에서 STRAPI_URL과 API 토큰을 설정하세요');
    }
  }
</script>
