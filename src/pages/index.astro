---
import MainLayout from '../layouts/MainLayout.astro';
import Slider from '../components/react/Slider';

const slides = [
  {
    id: 1,
    image: '/images/노인복지.jpg',
    title: '재가방문요양사업',
    description: '어르신들의 편안하고 행복한 노후를 위해 함께합니다',
  },
  {
    id: 2,
    image: '/images/장애인지원.jpg',
    title: '장애인활동지원사업',
    description: '모두가 함께하는 세상을 만들어갑니다',
  },
  {
    id: 3,
    image: '/images/청소년지원.jpg',
    title: '아동청소년성장지원사업',
    description: '우리 아이들의 밝은 미래를 응원합니다',
  },
];

// 최근 활동 샘플 데이터
const recentActivities = [
  {
    id: 1,
    image: '/images/노인복지.jpg',
    title: '제13회 강남구민화합축제 참여',
    date: '2025.10.18',
  },
  {
    id: 2,
    image: '/images/장애인지원.jpg',
    title: '제2회 대치4동 문화마당',
    date: '2025.09.27',
  },
  {
    id: 3,
    image: '/images/청소년지원.jpg',
    title: '창립총회 개최',
    date: '2025.07.17',
  },
];

// 최근 공지사항 샘플
const recentNotices = [
  {
    id: 1,
    title: '2025년 활동지원사 모집 안내',
    date: '2025.11.01',
  },
  {
    id: 2,
    title: '장애인활동지원사업 확대 운영',
    date: '2025.10.25',
  },
  {
    id: 3,
    title: '재가방문요양 신규 이용자 안내',
    date: '2025.10.15',
  },
];

// 행사일정 샘플
const upcomingEvents = [
  {
    id: 1,
    title: '아동청소년 역사문화탐방',
    date: '2025.11.20',
  },
  {
    id: 2,
    title: '활동지원사 보수교육',
    date: '2025.11.25',
  },
  {
    id: 3,
    title: '연말 송년회',
    date: '2025.12.15',
  },
];
---

<MainLayout title="홈">
  <div class="home-content">
    <!-- 레이어 팝업 (주황-노랑 그라데이션) -->
    <div id="layerPopup" class="layer-popup hidden">
      <div class="popup-overlay"></div>
      <div class="popup-container">
        <button class="popup-close" aria-label="닫기">✕</button>
        <div class="popup-badge">공지</div>
        <h3 class="popup-title">2025년 활동지원사 모집 안내</h3>
        <p class="popup-content">
          <span class="brand-emphasis">사회적협동조합 가치로운</span>에서 함께 일하실 활동지원사를 모집합니다.<br />
          따뜻한 마음과 봉사정신을 가지신 분들의 많은 지원 바랍니다.
        </p>
        <div class="popup-actions">
          <a href="/recruit" class="popup-btn btn-primary">자세히 보기</a>
          <button class="popup-btn btn-secondary popup-close-btn">오늘 하루 보지 않기</button>
        </div>
      </div>
    </div>

    <!-- 1. 메인 슬라이드 배너 -->
    <section id="slider" class="hero">
      <div class="container">
        <Slider slides={slides} client:load />
      </div>
    </section>

    <!-- 2. 최근 활동 사진 -->
    <section id="activities" class="section activities-section">
      <div class="container">
        <h2 class="section-title clickable-title">최근 활동</h2>
        <div class="activities-grid">
          {recentActivities.map((activity) => (
            <div class="activity-card">
              <div class="activity-image">
                <img 
                  src={activity.image} 
                  alt={activity.title}
                  onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\"placeholder-icon\">��</div>';"
                />
              </div>
              <div class="activity-content">
                <h3>{activity.title}</h3>
                <p class="activity-date">{activity.date}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="section-footer">
          <a href="/resources#activities" class="btn btn-outline">더 보기</a>
        </div>
      </div>
    </section>

    <!-- 3. 최근 공지사항 / 행사일정 -->
    <section id="notice" class="section news-section bg-light">
      <div class="container">
        <div class="news-grid">
          <!-- 공지사항 -->
          <div class="news-column">
            <h2 class="section-title clickable-title">공지사항</h2>
            <ul class="news-list">
              {recentNotices.map((notice) => (
                <li class="news-item">
                  <a href={`/notice#announcements`}>
                    <span class="news-title">{notice.title}</span>
                    <span class="news-date">{notice.date}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="news-footer">
              <a href="/notice#announcements" class="btn btn-sm">더 보기 →</a>
            </div>
          </div>

          <!-- 행사일정 -->
          <div class="news-column">
            <h2 class="section-title clickable-title">행사일정</h2>
            <ul class="news-list">
              {upcomingEvents.map((event) => (
                <li class="news-item">
                  <a href={`/notice#events`}>
                    <span class="news-title">{event.title}</span>
                    <span class="news-date">{event.date}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="news-footer">
              <a href="/notice#events" class="btn btn-sm">더 보기 →</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  /* 레이어 팝업 */
  .layer-popup {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease;
  }

  .layer-popup.hidden {
    display: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    cursor: pointer;
  }

  .popup-container {
    position: relative;
    background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-accent-50) 100%);
    max-width: 500px;
    width: 90%;
    padding: var(--spacing-3xl);
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: slideUp 0.3s ease;
    border: 3px solid transparent;
    background-image: 
      linear-gradient(white, white),
      linear-gradient(135deg, var(--color-primary-500) 0%, var(--color-accent-500) 100%);
    background-origin: border-box;
    background-clip: padding-box, border-box;
  }

  @keyframes slideUp {
    from {
      transform: translateY(30px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .popup-close {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
    width: 32px;
    height: 32px;
    border: none;
    background: var(--color-gray-200);
    color: var(--color-gray-700);
    border-radius: 50%;
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .popup-close:hover {
    background: var(--color-gray-300);
    transform: rotate(90deg);
  }

  .popup-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--color-primary-600) 0%, var(--color-accent-600) 100%);
    color: white;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: var(--spacing-md);
  }

  .popup-title {
    font-size: 1.75rem;
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .popup-content {
    color: var(--color-gray-700);
    line-height: 1.8;
    margin-bottom: var(--spacing-xl);
  }

  .popup-actions {
    display: flex;
    gap: var(--spacing-md);
    flex-direction: column;
  }

  .popup-btn {
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-md);
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    font-size: 1rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-primary-600) 0%, var(--color-accent-600) 100%);
    color: white;
    text-decoration: none;
    display: block;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .btn-secondary {
    background: var(--color-gray-100);
    color: var(--color-gray-700);
  }

  .btn-secondary:hover {
    background: var(--color-gray-200);
  }

  /* 메인 슬라이드 배너 */
  .hero {
    padding: var(--spacing-3xl) 0;
    background: var(--color-bg-light);
  }

  .hero .container {
    max-width: 1400px;
  }

  /* 최근 활동 */
  .activities-section {
    padding: var(--spacing-4xl) 0;
  }

  .clickable-title {
    cursor: pointer;
    position: relative;
    display: inline-block;
  }

  .clickable-title:hover {
    color: var(--color-primary-500);
  }

  .clickable-title:hover::after {
    content: '���';
    margin-left: var(--spacing-sm);
    font-size: 0.8em;
    opacity: 0.7;
  }

  .activities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-2xl);
  }

  .activity-card {
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all 0.3s ease;
  }

  .activity-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }

  .activity-image {
    width: 100%;
    height: 250px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-gray-100) 0%, var(--color-gray-200) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .activity-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder-icon {
    font-size: 4rem;
    opacity: 0.3;
  }

  .activity-content {
    padding: var(--spacing-lg);
  }

  .activity-content h3 {
    font-size: 1.125rem;
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-sm);
  }

  .activity-date {
    font-size: 0.875rem;
    color: var(--color-gray-500);
  }

  .section-footer {
    text-align: center;
  }

  /* 공지사항/행사일정 */
  .news-section {
    padding: var(--spacing-4xl) 0;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-3xl);
  }

  .news-column {
    background: white;
    border-radius: var(--radius-lg);
    padding: var(--spacing-2xl);
    box-shadow: var(--shadow-md);
  }

  .news-column .section-title {
    margin-bottom: var(--spacing-xl);
    color: var(--color-primary-600);
  }

  .news-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-lg) 0;
  }

  .news-item {
    border-bottom: 1px solid var(--color-gray-200);
  }

  .news-item:last-child {
    border-bottom: none;
  }

  .news-item a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md) 0;
    color: var(--color-gray-700);
    transition: all 0.2s ease;
  }

  .news-item a:hover {
    color: var(--color-primary-600);
    padding-left: var(--spacing-sm);
  }

  .news-title {
    flex: 1;
    font-weight: 500;
  }

  .news-date {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin-left: var(--spacing-md);
  }

  .news-footer {
    text-align: right;
  }

  .btn-sm {
    padding: var(--spacing-xs) var(--spacing-lg);
    font-size: 0.875rem;
  }

  /* 반응형 */
  @media (max-width: 1024px) {
    .activities-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .news-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-2xl);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--spacing-2xl) 0;
    }

    .activities-grid {
      grid-template-columns: 1fr;
    }

    .popup-title {
      font-size: 1.375rem;
    }

    .activity-image {
      height: 200px;
    }
  }
</style>

<script>
  // 레이어 팝업 제어
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('layerPopup');
    if (!popup) return;
    
    const closeButton = popup.querySelector('.popup-close');
    const hideTodayButton = popup.querySelector('.popup-close-btn');
    const overlay = popup.querySelector('.popup-overlay');
    
    // localStorage 확인 (오늘 하루 보지 않기)
    const hidePopupUntil = localStorage.getItem('hidePopupUntil');
    const today = new Date().toDateString();
    
    // 오늘 하루 보지 않기가 설정되지 않았으면 팝업 표시
    if (hidePopupUntil !== today) {
      popup.classList.remove('hidden');
    }

    // X 버튼 클릭 - 팝업만 닫기
    closeButton?.addEventListener('click', (e) => {
      e.stopPropagation();
      popup.classList.add('hidden');
    });

    // "오늘 하루 보지 않기" 버튼 클릭 - 팝업 닫고 localStorage 저장
    hideTodayButton?.addEventListener('click', (e) => {
      e.stopPropagation();
      localStorage.setItem('hidePopupUntil', today);
      popup.classList.add('hidden');
    });

    // 오버레이 클릭 시 닫기
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) {
        popup.classList.add('hidden');
      }
    });

    // ESC 키로 닫기
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popup.classList.contains('hidden')) {
        popup.classList.add('hidden');
      }
    });
  });

  // 섹션 제목 클릭 시 URL 복사
  document.querySelectorAll('.clickable-title').forEach(title => {
    title.addEventListener('click', async (e) => {
      const section = (e.target as HTMLElement).closest('section');
      if (!section?.id) return;
      
      const url = `${window.location.origin}${window.location.pathname}#${section.id}`;
      
      try {
        await navigator.clipboard.writeText(url);
        
        // 복사 성공 피드백
        const originalText = (e.target as HTMLElement).textContent;
        (e.target as HTMLElement).textContent = '링크 복사됨! ✓';
        (e.target as HTMLElement).style.color = 'var(--color-secondary-600)';
        
        setTimeout(() => {
          (e.target as HTMLElement).textContent = originalText;
          (e.target as HTMLElement).style.color = '';
        }, 2000);
      } catch (err) {
        console.error('URL 복사 실패:', err);
      }
    });
  });
</script>
