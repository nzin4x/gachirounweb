---
import MainLayout from '../layouts/MainLayout.astro';
import Slider from '../components/react/Slider';
import strapiClient from '../lib/strapi';
import { getEnv } from '../lib/env';

const slides = [
  {
    id: 1,
    image: '/images/노인복지.jpg',
    title: '재가방문요양사업',
    description: '어르신들의 편안하고 행복한 노후를 위해 함께합니다',
  },
  {
    id: 2,
    image: '/images/장애인지원.jpg',
    title: '장애인활동지원사업',
    description: '모두가 함께하는 세상을 만들어갑니다',
  },
  {
    id: 3,
    image: '/images/청소년지원.jpg',
    title: '아동청소년성장지원사업',
    description: '우리 아이들의 밝은 미래를 응원합니다',
  },
];

// 최근 활동 샘플 데이터 (3개만 표시)
const recentActivities = [
  {
    id: 1,
    image: '/images/노인복지.jpg',
    title: '제13회 강남구민화합축제 참여',
    date: '2025.10.18',
  },
  {
    id: 2,
    image: '/images/장애인지원.jpg',
    title: '제2회 대치4동 문화마당',
    date: '2025.09.27',
  },
  {
    id: 3,
    image: '/images/청소년지원.jpg',
    title: '창립총회 개최',
    date: '2025.07.17',
  },
  {
    id: 'more',
    isMore: true,
    title: '더보기',
    link: '/resources#activities',
  },
];

// 환경 변수 공통 헬퍼 사용
const env = getEnv(Astro.locals);

// Strapi에서 팝업 가져오기 (show=true, startsAt<=now, endsAt>=now)
const popupData: Awaited<ReturnType<typeof strapiClient.getPopups>>[0] | null = await (async () => {
  try {
    const data = await strapiClient.getPopups(env);
    return Array.isArray(data) && data.length > 0 ? data[0] : null;
  } catch (e) {
    console.warn('[Home] Failed to load popup from Strapi:', e);
    return null;
  }
})();

// Strapi에서 최근 공지사항 가져오기 (3개)
const recentNotices = await (async () => {
  try {
    const data = await strapiClient.getAnnouncements(3, env);
    return Array.isArray(data) ? data : [];
  } catch (e) {
    console.warn('[Home] Failed to load recent notices from Strapi:', e);
    return [];
  }
})();

// 행사일정 샘플
const upcomingEvents = [
  {
    id: 1,
    title: '아동청소년 역사문화탐방',
    date: '2025.11.20',
  },
  {
    id: 2,
    title: '활동지원사 보수교육',
    date: '2025.11.25',
  },
  {
    id: 3,
    title: '연말 송년회',
    date: '2025.12.15',
  },
];
---

<MainLayout title="가치로운 홈페이지">
  <div class="home-content">
    <!-- 레이어 팝업 (동적 Strapi 데이터) -->
    {popupData && (
      <div id="layerPopup" class="layer-popup hidden" data-popup-id={popupData.id} data-strapi-path={popupData._strapiPath}>
        <div class="popup-overlay"></div>
        <div class="popup-container">
          <button class="popup-close" aria-label="닫기">✕</button>
          <div class="popup-badge">공지</div>
          <h3 class="popup-title" data-strapi-path={popupData._strapiFields?.title}>{popupData.title}</h3>
          {popupData.photo && (
            <div class="popup-image">
              <img 
                src={popupData.photo.url.startsWith('http') ? popupData.photo.url : `${env.STRAPI_URL}${popupData.photo.url}`} 
                alt={popupData.photo.alternativeText || popupData.title} 
                data-strapi-path={popupData._strapiFields?.photo}
              />
            </div>
          )}
          <div class="popup-content" data-strapi-path={popupData._strapiFields?.body} set:html={popupData.body} />
          <div class="popup-actions">
            {popupData.link && (
              <a href={popupData.link} class="popup-btn btn-primary" data-strapi-path={popupData._strapiFields?.link}>
                {popupData.linkText || '자세히 보기'}
              </a>
            )}
            <button class="popup-btn btn-secondary popup-close-btn">오늘 하루 보지 않기</button>
          </div>

          {/* 팝업 게시기간 표시 (더 작고 회색) */}
          {popupData.startsAt && popupData.endsAt && (
            <div class="popup-period">
              <span>
                게시기간: {new Date(popupData.startsAt).toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                ~ {new Date(popupData.endsAt).toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </span>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- 1. 메인 슬라이드 배너 -->
    <section id="slider" class="hero">
      <div class="container">
        <Slider slides={slides} client:load />
      </div>
    </section>

    <!-- 2. 최근 활동 사진 -->
    <section id="activities" class="section activities-section">
      <div class="container">
        <h2 class="section-title clickable-title">최근 활동</h2>
        <div class="activities-grid">
          {recentActivities.filter(a => !a.isMore).map((activity) => (
            <div class="activity-card">
              <div class="activity-image">
                <img 
                  src={activity.image} 
                  alt={activity.title}
                  onerror="this.onerror=null; this.style.display='none'; this.parentElement.classList.add('no-image');"
                />
                <div class="placeholder-icon">📸</div>
              </div>
              <div class="activity-content">
                <h3>{activity.title}</h3>
                <p class="activity-date">{activity.date}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="news-footer">
          <a href="/resources#activities" class="btn btn-sm">더 보기 →</a>
        </div>
      </div>
    </section>

    <!-- 3. 최근 공지사항 / 행사일정 -->
    <section id="notice" class="section news-section bg-light">
      <div class="container">
        <div class="news-grid">
          <!-- 공지사항 -->
          <div class="news-column">
            <h2 class="section-title clickable-title">공지사항</h2>
            <ul class="news-list">
              {recentNotices.map((notice: any, idx: number) => (
                <li class="news-item">
                  <a href={`/notice#notice-notice-${idx}`}>
                    <span class="news-title">{notice.title}</span>
                    <span class="news-date">{notice.createdAt ? new Date(notice.createdAt).toLocaleDateString('ko-KR') : ''}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="news-footer">
              <a href="/notice#announcements" class="btn btn-sm">더 보기 →</a>
            </div>
          </div>

          <!-- 행사일정 -->
          <div class="news-column">
            <h2 class="section-title clickable-title">행사일정</h2>
            <ul class="news-list">
              {upcomingEvents.map((event) => (
                <li class="news-item">
                  <a href={`/notice#events`}>
                    <span class="news-title">{event.title}</span>
                    <span class="news-date">{event.date}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="news-footer">
              <a href="/notice#events" class="btn btn-sm">더 보기 →</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  /* 레이어 팝업 */
  .layer-popup {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease;
  }

  .layer-popup.hidden {
    display: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    cursor: pointer;
  }

  .popup-container {
    position: relative;
    background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-accent-50) 100%);
    max-width: 500px;
    width: 90%;
    padding: var(--spacing-3xl);
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: slideUp 0.3s ease;
    border: 3px solid transparent;
    background-image: 
      linear-gradient(white, white),
      linear-gradient(135deg, var(--color-primary-500) 0%, var(--color-accent-500) 100%);
    background-origin: border-box;
    background-clip: padding-box, border-box;
  }

  @keyframes slideUp {
    from {
      transform: translateY(30px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .popup-close {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
    width: 32px;
    height: 32px;
    border: none;
    background: var(--color-gray-200);
    color: var(--color-gray-700);
    border-radius: 50%;
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .popup-close:hover {
    background: var(--color-gray-300);
    transform: rotate(90deg);
  }

  .popup-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--color-primary-600) 0%, var(--color-accent-600) 100%);
    color: white;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: var(--spacing-md);
  }

  .popup-title {
    font-size: 1.75rem;
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .popup-image {
    margin: var(--spacing-lg) 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .popup-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .popup-content {
    color: var(--color-gray-700);
    line-height: 1.8;
    margin-bottom: var(--spacing-xl);
  }

  .popup-actions {
    display: flex;
    gap: var(--spacing-md);
    flex-direction: column;
  }

  .popup-btn {
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-md);
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    font-size: 1rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-primary-600) 0%, var(--color-accent-600) 100%);
    color: white;
    text-decoration: none;
    display: block;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .btn-secondary {
    background: var(--color-gray-100);
    color: var(--color-gray-700);
  }

  .btn-secondary:hover {
    background: var(--color-gray-200);
  }

  /* 메인 슬라이드 배너 */
  .hero {
    padding: var(--spacing-3xl) 0;
    background: var(--color-bg-light);
  }

  .hero .container {
    max-width: 1400px;
  }

  /* 최근 활동 */
  .activities-section {
    padding: var(--spacing-4xl) 0;
  }

  .activities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-2xl);
  }

  .activity-card {
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    overflow: hidden;
    border-top: 3px solid var(--color-primary-500);
    transition: all 0.3s ease;
    position: relative;
    isolation: isolate; /* 각 카드의 독립성 확보 */
  }

  .activity-card:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .more-card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    text-decoration: none;
    color: var(--color-gray-700);
    grid-column: span 1;
  }

  .more-content {
    text-align: center;
    padding: var(--spacing-lg);
  }

  .more-icon {
    font-size: 2.5rem;
    display: inline-block;
    margin-right: var(--spacing-sm);
    color: var(--color-accent-500);
    transition: transform 0.3s ease;
    animation: rotate 4s linear infinite;
  }

  @keyframes rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .more-card:hover .more-icon {
    animation-duration: 1s;
  }

  .more-card h3 {
    font-size: 1.25rem;
    margin: 0;
    color: var(--color-primary-600);
    display: inline;
  }

  .more-card p {
    font-size: 0.9rem;
    color: var(--color-gray-600);
    margin: var(--spacing-sm) 0 0 0;
  }

  /* PC: 더보기 카드 전체 너비 */
  @media (min-width: 1025px) {
    .more-card {
      grid-column: 1 / -1;
      min-height: 120px;
    }
  }

  /* 모바일: 더보기 카드 높이 줄이기 */
  @media (max-width: 480px) {
    .more-card {
      min-height: 100px;
    }
    
    .more-icon {
      font-size: 2rem;
    }
    
    .more-card h3 {
      font-size: 1.1rem;
    }
  }

  .activity-image {
    width: 100%;
    height: 300px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-gray-100) 0%, var(--color-gray-200) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .activity-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }

  .placeholder-icon {
    font-size: 4rem;
    opacity: 0.3;
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .activity-image.no-image img {
    display: none;
  }

  .activity-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.6) 70%, transparent 100%);
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg);
    color: white;
    z-index: 2;
    pointer-events: none; /* 텍스트가 다른 카드 영역을 침범하지 않도록 */
  }

  .activity-content h3 {
    font-size: 1.125rem;
    color: white;
    margin-bottom: var(--spacing-xs);
    font-weight: 600;
    line-height: 1.4;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .activity-date {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .section-footer {
    text-align: center;
  }

  /* 공지사항/행사일정 */
  .news-section {
    padding: var(--spacing-4xl) 0;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-3xl);
  }

  .news-column {
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-top: 3px solid var(--color-primary-500);
  }

  .news-column .section-title {
    margin-bottom: var(--spacing-xl);
    color: var(--color-primary-600);
  }

  .news-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-lg) 0;
  }

  .news-item {
    border-bottom: 1px solid var(--color-gray-200);
  }

  .news-item:last-child {
    border-bottom: none;
  }

  .news-item a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md) 0;
    color: var(--color-gray-700);
    transition: all 0.2s ease;
  }

  .news-item a:hover {
    color: var(--color-primary-600);
    padding-left: var(--spacing-sm);
  }

  .news-title {
    flex: 1;
    font-weight: 500;
  }

  .news-date {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin-left: var(--spacing-md);
  }

  .news-footer {
    text-align: right;
  }

  .btn-sm {
    padding: var(--spacing-xs) var(--spacing-lg);
    font-size: 0.875rem;
  }

  /* 반응형 */
  @media (max-width: 1024px) {
    .activities-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .news-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-2xl);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--spacing-2xl) 0;
    }

    .activities-grid {
      grid-template-columns: 1fr;
    }

    .popup-title {
      font-size: 1.375rem;
    }

    .activity-image {
      height: 250px;
    }
    
    .activity-content {
      padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);
    }
    
    .activity-content h3 {
      font-size: 1rem;
    }

    .news-column {
      padding: var(--spacing-sm) var(--spacing-md);
      border-top-width: 2px;
    }
  }

  .popup-period {
    text-align: left;
    font-size: 0.75rem;
    color: var(--color-gray-400);
    margin: var(--spacing-xs) 0 var(--spacing-xs) 0;
    letter-spacing: 0.01em;
    font-weight: 400;
  }
</style>

<script>
  // 레이어 팝업 제어 (localStorage + 쿠키 domain=.gachiroun.or.kr)
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('layerPopup');
    if (!popup) return;
    const closeButton = popup.querySelector('.popup-close');
    const hideTodayButton = popup.querySelector('.popup-close-btn');
    const overlay = popup.querySelector('.popup-overlay');
    const today = new Date().toDateString();

    // 쿠키 읽기 함수
    function getCookie(name: string): string | undefined {
      const value = `; ${document.cookie}`;
      const parts = value.split(`; ${name}=`);
      if (parts.length === 2) return parts.pop()?.split(';').shift();
    }

    // 팝업 ID 가져오기
    const popupId = popup.getAttribute('data-popup-id');
    if (!popupId) {
      console.warn('[Popup] No popup ID found');
      return;
    }

    // localStorage/쿠키 확인 (팝업 ID별로 체크)
    const hidePopupUntil = localStorage.getItem(`hidePopup_${popupId}`);
    const hidePopupCookie = getCookie(`hidePopup_${popupId}`);
    if (hidePopupUntil === today || hidePopupCookie === today) {
      popup.classList.add('hidden');
    } else {
      popup.classList.remove('hidden');
    }

    // X 버튼 클릭 - 팝업만 닫기
    closeButton?.addEventListener('click', (e) => {
      e.stopPropagation();
      popup.classList.add('hidden');
    });

    // "오늘 하루 보지 않기" 버튼 클릭 - 팝업 닫고 localStorage+쿠키 저장
    hideTodayButton?.addEventListener('click', (e) => {
      e.stopPropagation();
      const popupId = popup.getAttribute('data-popup-id');
      if (popupId) {
        localStorage.setItem(`hidePopup_${popupId}`, today);
        // domain=.gachiroun.or.kr로 쿠키 저장 (1일)
        document.cookie = `hidePopup_${popupId}=${today}; path=/; domain=.gachiroun.or.kr; max-age=86400; SameSite=Lax`;
      }
      popup.classList.add('hidden');
    });

    // 오버레이 클릭 시 닫기
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) {
        popup.classList.add('hidden');
      }
    });

    // ESC 키로 닫기
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popup.classList.contains('hidden')) {
        popup.classList.add('hidden');
      }
    });
  });

</script>
