---
import MainLayout from '../layouts/MainLayout.astro';

// 가상 활동 내역 샘플
const activities = [
  {
    id: 1,
    title: '제13회 강남구민화합축제 참여',
    date: '2025-10-18',
    image: '/images/ci.png',
    description: '강남구민과 함께한 화합의 축제'
  },
  {
    id: 2,
    title: '제2회 대치4동 문화마당',
    date: '2025-09-27',
    image: '/images/ci.png',
    description: '이경지 여사 추모식 및 지역 문화행사'
  },
  {
    id: 3,
    title: '청소년 역사문화탐방',
    date: '2025-08-15',
    image: '/images/ci.png',
    description: '청소년들과 함께한 역사문화 체험'
  },
  {
    id: 4,
    title: '어르신 말벗 봉사활동',
    date: '2025-07-20',
    image: '/images/ci.png',
    description: '지역 어르신들과의 따뜻한 만남'
  },
  {
    id: 5,
    title: '장애인 인식개선 캠페인',
    date: '2025-06-10',
    image: '/images/ci.png',
    description: '지역사회 장애인 인식개선 활동'
  },
  {
    id: 6,
    title: '환경보호 캠페인',
    date: '2025-05-22',
    image: '/images/ci.png',
    description: '청소년과 함께하는 환경정화 활동'
  }
];

// 다운로드 가능한 서식 목록
const forms = [
  {
    id: 1,
    category: '봉사활동',
    title: '봉사활동 신청서',
    description: '자원봉사 신청 시 작성하는 양식입니다.',
    filename: '봉사활동신청서.pdf',
    icon: '📄'
  },
  {
    id: 3,
    category: '후원',
    title: '정기후원 신청서',
    description: '정기후원 신청 시 작성하는 양식입니다.',
    filename: '정기후원신청서.pdf',
    icon: '📄'
  },
];
---

<MainLayout title="자료실">
  <div class="page-container">
    <!-- 활동 내역 -->
    <section id="activities" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">활동 내역</h2>
        <div class="value-content logo-description">
          <p>사회적협동조합 가치로운의 다양한 활동을 사진으로 확인하세요.</p>
        </div>

        <div class="activities-grid">
          {activities.map((activity) => (
            <div class="activity-card">
              <div class="activity-image">
                <img src={activity.image} alt={activity.title} />
                <div class="activity-overlay">
                  <span class="activity-date">{activity.date}</span>
                </div>
              </div>
              <div class="activity-content">
                <h3>{activity.title}</h3>
                <p>{activity.description}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="more-info simple-card">
          <p>
            📸 더 많은 활동 사진은 인스타그램에서 확인하세요!<br />
            <a href="#" class="social-link">@gachiroun_official</a>
          </p>
        </div>
      </div>
    </section>

    <!-- 서식 다운로드 -->
    <section id="downloads" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title clickable-title">서식 다운로드</h2>
        <div class="value-content logo-description">
          <p>각종 신청서 및 안내 자료를 다운로드하실 수 있습니다.</p>
        </div>

        <div class="forms-list">
          {forms.map((form) => (
            <div class="form-item">
              <div class="form-icon">
                <span>{form.icon}</span>
              </div>
              <div class="form-info">
                <span class="form-category">{form.category}</span>
                <h3>{form.title}</h3>
                <p>{form.description}</p>
              </div>
              <div class="form-download">
                <button 
                  class="btn-download" 
                  onclick="alert('서식이 준비중입니다. 문의: 02-6952-4756')"
                >
                  다운로드
                </button>
              </div>
            </div>
          ))}
        </div>

        <div class="download-notice">
          <h3>다운로드 안내</h3>
          <ul>
            <li>모든 서식은 PDF 형식으로 제공됩니다.</li>
            <li>서식 작성 후 이메일 또는 방문 제출이 가능합니다.</li>
            <li>문의사항: <a href="tel:02-6952-4756">02-6952-4756</a></li>
            <li>이메일: <a href="mailto:gachiroun@gmail.com">gachiroun@gmail.com</a></li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .page-container {
    width: 100%;
  }

  .content-section {
    padding: var(--spacing-4xl) 0;
    scroll-margin-top: 80px;
  }

  .content-section.bg-light {
    background-color: var(--color-bg-light);
  }

  .section-description {
    text-align: center;
    color: var(--color-gray-600);
    font-size: 1.1rem;
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-3xl);
  }

  /* 활동 내역 - 인스타그램 스타일 */
  .activities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-2xl);
  }

  .activity-card {
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    overflow: hidden;
    border-top: 3px solid var(--color-primary-500);
    transition: all 0.3s ease;
  }

  .activity-card:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .activity-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-gray-100);
  }

  .activity-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .activity-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.7) 100%);
    display: flex;
    align-items: flex-end;
    padding: var(--spacing-lg);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .activity-card:hover .activity-overlay {
    opacity: 1;
  }

  .activity-date {
    color: white;
    font-size: 0.9rem;
    font-weight: bold;
  }

  .activity-content {
    padding: var(--spacing-lg);
  }

  .activity-content h3 {
    color: var(--color-primary-700);
    margin-bottom: var(--spacing-sm);
    font-size: 1.1rem;
  }

  .activity-content p {
    color: var(--color-gray-600);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .more-info {
    text-align: center;
    margin-top: var(--spacing-4xl);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .more-info p {
    font-size: 1rem;
    line-height: 1.8;
  }

  .section-intro {
    text-align: center;
    max-width: 800px;
    margin: var(--spacing-lg) auto var(--spacing-2xl);
  }

  .section-intro p {
    font-size: 1rem;
    line-height: 1.6;
  }

  .social-link {
    color: var(--color-primary-600);
    font-weight: bold;
    text-decoration: none;
  }

  .social-link:hover {
    text-decoration: underline;
  }

  /* 서식 다운로드 */
  .forms-list {
    margin-top: var(--spacing-2xl);
  }

  .form-item {
    background: var(--color-gray-50);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-lg);
    border-top: 3px solid var(--color-primary-500);
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    transition: all 0.3s ease;
  }

  .form-item:hover {
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .form-icon {
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .form-icon span {
    font-size: 2rem;
  }

  .form-info {
    flex: 1;
  }

  .form-category {
    display: inline-block;
    color: var(--color-primary-500);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
  }

  .form-info h3 {
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-xs);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .form-info p {
    color: var(--color-gray-600);
    font-size: 0.95rem;
  }

  .form-download {
    flex-shrink: 0;
  }

  .btn-download {
    background: var(--color-primary-600);
    color: white;
    border: none;
    padding: var(--spacing-md) var(--spacing-xl);
    border-radius: var(--radius-md);
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s;
  }

  .btn-download:hover {
    background: var(--color-primary-700);
  }

  .download-notice {
    margin-top: var(--spacing-3xl);
    padding: var(--spacing-lg) var(--spacing-xl);
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-accent-500);
  }

  .download-notice h3 {
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-lg);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .download-notice ul {
    list-style: none;
    padding: 0;
  }

  .download-notice li {
    padding: var(--spacing-sm) 0 var(--spacing-sm) var(--spacing-md);
    position: relative;
  }

  .download-notice li::before {
    content: '●';
    position: absolute;
    left: 0;
    font-size: 0.6em;
    top: 0.6em;
    color: var(--color-primary-500);
  }

  .download-notice a {
    color: var(--color-primary-600);
    text-decoration: none;
  }

  .download-notice a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .activities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .activities-grid {
      grid-template-columns: 1fr;
    }

    .activity-card,
    .form-item,
    .download-notice {
      padding: var(--spacing-sm) var(--spacing-md);
      border-top-width: 2px;
    }

    .form-item {
      flex-direction: column;
      text-align: center;
    }

    .form-icon {
      margin-bottom: var(--spacing-sm);
    }

    .form-download {
      width: 100%;
    }

    .btn-download {
      width: 100%;
    }
  }
</style>

<script>
  // Smooth scroll for hashbang navigation
  document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash;
    if (hash) {
      setTimeout(() => {
        const element = document.querySelector(hash);
        if (element) {
          element.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 100);
    }
  });

  // Track hashbang navigation
  window.addEventListener('hashchange', () => {
    if (typeof window.gtag !== 'undefined') {
      window.gtag('config', 'GTM-MVL6P7N7', {
        page_path: window.location.pathname + window.location.hash
      });
    }
  });

  // Dynamic title
  const sectionTitles: Record<string, string> = {
    'activities': '최근 활동',
    'downloads': '자료실'
  };

  function updateTitle() {
    const hash = window.location.hash.replace('#', '') || 'activities';
    const sectionTitle = sectionTitles[hash] || '최근 활동';
    document.title = `자료 > ${sectionTitle} | 사회적협동조합 가치로운`;
  }

  window.addEventListener('hashchange', updateTitle);
  
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const sections = document.querySelectorAll('section[id]');
        let currentSection = 'activities';
        
        sections.forEach(section => {
          const rect = section.getBoundingClientRect();
          if (rect.top <= 150 && rect.bottom >= 150) {
            currentSection = section.id;
          }
        });
        
        const newHash = '#' + currentSection;
        if (window.location.hash !== newHash) {
          history.replaceState(null, '', newHash);
          updateTitle();
        }
        
        ticking = false;
      });
      ticking = true;
    }
  });

  document.addEventListener('DOMContentLoaded', updateTitle);
  updateTitle();
</script>
