---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="사업소개">
  <div class="page-container">
    <!-- 주요사업 개요 -->
    <section id="overview" class="content-section">
      <div class="container">
        <h2 class="section-title clickable-title">주요사업</h2>
        <div class="services-grid">
          <div class="service-card">
            <h3>재가방문요양사업</h3>
            <ul>
              <li>어르신 맞춤형 돌봄 서비스 제공</li>
              <li>전문 요양보호사 파견</li>
              <li>일상생활 지원 및 건강관리</li>
              <li>정서적 지원 및 말벗 서비스</li>
              <li>가족 돌봄제공자 지원</li>
              <li>지역사회 자원 연계</li>
            </ul>
          </div>

          <div class="service-card">
            <h3>장애인활동지원사업</h3>
            <ul>
              <li>장애인의 자립생활 지원</li>
              <li>일상생활 및 사회활동 보조</li>
              <li>맞춤형 활동지원 서비스 제공</li>
              <li>장애인 권리 증진 활동</li>
              <li>가족지원 프로그램 운영</li>
              <li>지역사회 인식 개선 활동</li>
            </ul>
          </div>

          <div class="service-card">
            <h3>아동청소년성장지원사업</h3>
            <ul>
              <li>금연지도 캠페인</li>
              <li>학폭, 도박, 마약, 딥페이크 근절 캠페인</li>
              <li>청소년오케스트라 운영 지원</li>
              <li>학부모오케스트라 운영 지원</li>
              <li>청소년 역사탐방 프로그램 지원</li>
              <li>환경보호 캠페인 등 지역사회 연계 활동</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 재가방문요양사업 -->
    <section id="elderly" class="content-section bg-light service-detail-section">
      <div class="container">
        <h2 class="section-title clickable-title">재가방문요양사업</h2>
        
        <div class="detail-cards">
          <div class="simple-card">
            <h3>서비스 내용 및 대상</h3>
            <p><strong>대상:</strong> 65세 이상 장기요양등급 수급자</p>
            <p><strong>내용:</strong> 식사 및 복약 지원, 개인위생 및 신체활동 보조, 가사 및 일상생활 지원</p>
          </div>

          <div class="simple-card">
            <h3>전문 인력 확보 및 교육</h3>
            <p>전문 요양보호사 채용 및 관리, 정기적인 직무 교육, 요양보호사·이용인 인권교육, 스트레스 관리 프로그램</p>
          </div>

          <div class="simple-card">
            <h3>품질 관리 시스템</h3>
            <p>서비스 만족도 조사, 케어 플랜 수립 및 평가, 보호자 소통 채널, 이용인 인권 위원회 운영</p>
          </div>
        </div>
      </div>
      <div class="section-bg-image elderly-bg"></div>
    </section>

    <!-- 장애인활동지원사업 -->
    <section id="disability" class="content-section service-detail-section">
      <div class="container">
        <h2 class="section-title clickable-title">장애인활동지원사업</h2>

        <div class="detail-cards">
          <div class="simple-card">
            <h3>서비스 범위 및 특징</h3>
            <p>일상생활 및 사회활동 지원, 개인별 맞춤 서비스, 24시간 활동지원 서비스, 이용인 중심의 품질 관리</p>
          </div>

          <div class="simple-card">
            <h3>장애인 권리 증진</h3>
            <p>자기결정권 존중, 맞춤형 지원계획 수립, 정기 인권교육, 권리 옹호 시스템 구축</p>
          </div>

          <div class="simple-card">
            <h3>지역사회 연계</h3>
            <p>장애인 단체 협력 네트워크, 자원 연계 및 활용, 가족 지원 프로그램, 장애이해 캠페인</p>
          </div>

          <div class="simple-card">
            <h3>전문 인력 확보 및 교육</h3>
            <p>활동지원사 양성 교육, 정기 보수교육 및 역량강화, 활동지원사·이용인 인권교육, 직원 복지 향상</p>
          </div>
        </div>
      </div>
      <div class="section-bg-image disabled-bg"></div>
    </section>

    <!-- 아동청소년성장지원사업 -->
    <section id="youth" class="content-section bg-light service-detail-section">
      <div class="container">
        <h2 class="section-title clickable-title">아동청소년성장지원사업</h2>

        <div class="detail-cards">
          <div class="simple-card">
            <h3>청소년 인권보호사업</h3>
            <p>금연 지도 및 계도, 학교폭력·마약·도박·딥페이크 근절 캠페인을 통해 청소년의 건강하고 안전한 성장 환경을 조성합니다.</p>
          </div>

          <div class="simple-card">
            <h3>안전한 학교주변 환경조성</h3>
            <p>유해업소 청소년 출입 점검 및 등하굣길 도로안전 개선사업으로 청소년들이 안심하고 생활할 수 있는 환경을 만듭니다.</p>
          </div>

          <div class="simple-card">
            <h3>건강한 시민, 사회참여</h3>
            <p>아동청소년 자원봉사 연계 및 아동장애인과의 1:1 결연 후원을 통해 사회적 책임감과 공동체 의식을 함양합니다.</p>
          </div>

          <div class="simple-card">
            <h3>환경교육 및 기후위기 캠페인</h3>
            <p>환경보호 교육 프로그램과 지역사회 기후위기 대응 활동으로 미래 세대의 환경 감수성을 키웁니다.</p>
          </div>

          <div class="simple-card">
            <h3>예술로 연결되는 정서적 회복</h3>
            <p>아동청소년/학부모 오케스트라 운영 지원 및 역사문화탐방을 통해 정서적 안정과 문화 감수성을 증진합니다.</p>
          </div>

        </div>
      </div>
      <div class="section-bg-image youth-bg"></div>
    </section>
  </div>
</MainLayout>

<style>
  .page-container {
    width: 100%;
  }

  .content-section {
    padding: var(--spacing-4xl) 0;
    scroll-margin-top: 80px;
  }

  .content-section.bg-light {
    background-color: var(--color-bg-light);
  }

  /* 주요사업 */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-2xl);
  }

  .service-card {
    background: white;
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border-top: 4px solid var(--color-primary-600);
    transition: all 0.3s ease;
  }
  
  .service-card:hover {
    background: white;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    border-top-color: var(--color-accent-500);
    transform: translateY(-2px);
  }

  .service-card h3 {
    color: var(--color-primary-600);
    margin-bottom: var(--spacing-lg);
    font-size: 1.3rem;
  }

  .service-card ul {
    list-style: none;
    padding: 0;
  }

  .service-card li {
    padding: var(--spacing-xs) 0;
    margin-bottom: var(--spacing-xs);
  }
  
  .service-card li::before {
    content: "●";
    font-size: 0.6em;
    margin-right: 0.3em;
    vertical-align: middle;
    color: var(--color-primary-500);
  }

  /* 상세 박스 */
  .detail-box {
    background: white;
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-2xl);
    box-shadow: var(--shadow-sm);
  }

  .detail-box h3 {
    color: var(--color-primary-600);
    margin-bottom: var(--spacing-lg);
    font-size: 1.4rem;
    padding-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--color-primary-600);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-lg);
  }

  .content-item strong {
    display: block;
    color: var(--color-primary-600);
    font-size: 1.1rem;
    margin-bottom: var(--spacing-sm);
  }

  .content-item ul {
    list-style: none;
    padding: 0;
  }

  .content-item li {
    padding: var(--spacing-xs) 0;
    margin-bottom: var(--spacing-xs);
  }
  
  .content-item li::before {
    content: "●";
    margin-right: var(--spacing-xs);
    color: var(--color-primary-500);
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin-top: var(--spacing-lg);
  }

  .feature-list li {
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-gray-50);
    margin-bottom: var(--spacing-xs);
    border-radius: var(--radius-sm);
  }
  
  .feature-list li::before {
    content: "▸";
    font-size: 0.8em;
    margin-right: 0.3em;
    vertical-align: middle;
    color: var(--color-accent-500);
  }

  /* 아동청소년 */
  .intro-text {
    background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-accent-50) 100%);
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-3xl);
    text-align: center;
  }

  /* 컴팩트한 상세 카드 스타일 */
  .service-detail-section {
    position: relative;
    overflow: hidden;
    padding-bottom: var(--spacing-4xl);
  }

  /* detail-cards: content-grid 사용 */
  .detail-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }

  /* 배경 이미지 */
  .section-bg-image {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 400px;
    height: 400px;
    opacity: 0.9;
    pointer-events: none;
    z-index: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: right bottom;
  }

  .elderly-bg {
    background-image: url('/images/bg-elders.png');
  }

  .disabled-bg {
    background-image: url('/images/bg-disabled.png');
  }

  .youth-bg {
    background-image: url('/images/bg-children.png');
  }

  .service-detail-section .container {
    position: relative;
    z-index: 1;
  }

    @media (max-width: 1024px) and (min-width: 780px) {
    /* 780~1024는 PC와 동일하게 3단 유지 */
  }

  @media (max-width: 779px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .youth-programs {
      grid-template-columns: 1fr;
    }

    .detail-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 779px) and (min-width: 641px) {
    /* 태블릿: 2단 유지 */
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 640px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .section-bg-image {
      width: 200px;
      height: 200px;
    }
    
    /* 모바일: 1단 */
    .services-grid {
      gap: var(--spacing-md);
      margin-top: var(--spacing-lg);
      grid-template-columns: 1fr;
    }
    
    .service-card {
      padding: var(--spacing-sm) var(--spacing-md);
    }
    
    .service-card h3 {
      font-size: 1rem;
      margin-bottom: var(--spacing-xs);
    }
    
    .service-card li {
      font-size: 0.9rem;
      line-height: 1.5;
    }
    
    .detail-cards {
      gap: var(--spacing-md);
    }
  }
</style>

<script>
  // Smooth scroll for hashbang navigation
  document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash;
    if (hash) {
      setTimeout(() => {
        const element = document.querySelector(hash);
        if (element) {
          element.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 100);
    }
  });

  // Track hashbang navigation
  window.addEventListener('hashchange', () => {
    if (typeof window.gtag !== 'undefined') {
      window.gtag('config', 'GTM-MVL6P7N7', {
        page_path: window.location.pathname + window.location.hash
      });
    }
  });

  // Dynamic title based on scroll position and hash
  const sectionTitles: Record<string, string> = {
    'overview': '주요사업',
    'elderly': '재가방문요양사업',
    'disability': '장애인활동지원',
    'youth': '아동청소년지원'
  };

  function updateTitle() {
    const hash = window.location.hash.replace('#', '') || 'overview';
    const sectionTitle = sectionTitles[hash] || '주요사업';
    document.title = `사업소개 > ${sectionTitle} | 사회적협동조합 가치로운`;
  }

  // Update title on hash change
  window.addEventListener('hashchange', updateTitle);
  
  // Update title on scroll (detect which section is visible)
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const sections = document.querySelectorAll('section[id]');
        let currentSection = 'overview';
        
        sections.forEach(section => {
          const rect = section.getBoundingClientRect();
          if (rect.top <= 150 && rect.bottom >= 150) {
            currentSection = section.id;
          }
        });
        
        const newHash = '#' + currentSection;
        if (window.location.hash !== newHash) {
          history.replaceState(null, '', newHash);
          updateTitle();
        }
        
        ticking = false;
      });
      ticking = true;
    }
  });

  // Initial title update on page load
  document.addEventListener('DOMContentLoaded', updateTitle);
  updateTitle();
</script>
