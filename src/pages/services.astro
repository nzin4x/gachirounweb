---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="사업소개">
  <div class="page-container">
    <!-- 주요 사업 활동 개요 -->
    <section id="overview" class="content-section">
      <div class="container">
        <h2 class="section-title">주요 사업 활동</h2>
        <div class="services-grid">
          <div class="service-card">
            <h3>재가방문요양 사업</h3>
            <ul>
              <li>어르신 맞춤형 돌봄 서비스 제공</li>
              <li>전문 요양보호사 파견</li>
              <li>일상생활 지원 및 건강관리</li>
              <li>정서적 지원 및 말벗 서비스</li>
              <li>가족 돌봄제공자 지원</li>
              <li>지역사회 자원 연계</li>
            </ul>
          </div>

          <div class="service-card">
            <h3>장애인활동지원 사업</h3>
            <ul>
              <li>장애인의 자립생활 지원</li>
              <li>일상생활 및 사회활동 보조</li>
              <li>맞춤형 활동지원 서비스 제공</li>
              <li>장애인 권리 증진 활동</li>
              <li>가족지원 프로그램 운영</li>
              <li>지역사회 인식 개선 활동</li>
            </ul>
          </div>

          <div class="service-card">
            <h3>아동청소년성장지원 사업</h3>
            <ul>
              <li>금연지도 캠페인</li>
              <li>학폭, 도박, 마약, 딥페이크 근절 캠페인</li>
              <li>청소년오케스트라 운영 지원</li>
              <li>학부모오케스트라 운영 지원</li>
              <li>청소년 역사탐방 프로그램 지원</li>
              <li>환경보호 캠페인 등 지역사회 연계 활동</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 재가방문요양사업 -->
    <section id="elderly" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title">재가방문요양 사업</h2>
        
        <div class="detail-box">
          <h3>서비스 내용 및 대상</h3>
          <div class="content-grid">
            <div class="content-item">
              <strong>대상</strong>
              <p>65세 이상 장기요양등급 수급자</p>
            </div>
            <div class="content-item">
              <strong>서비스 내용</strong>
              <ul>
                <li>식사 및 복약 지원</li>
                <li>개인위생 및 신체활동 보조</li>
                <li>가사 및 일상생활 지원</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="detail-box">
          <h3>전문 인력 확보 및 교육</h3>
          <ul class="feature-list">
            <li>전문 요양보호사 채용 및 관리</li>
            <li>정기적인 직무 교육 실시</li>
            <li>요양보호사를 위한 인권교육</li>
            <li>이용인을 위한 인권교육</li>
            <li>스트레스 관리 프로그램 운영</li>
          </ul>
        </div>

        <div class="detail-box">
          <h3>품질 관리 시스템</h3>
          <ul class="feature-list">
            <li>정기적인 서비스 만족도 조사</li>
            <li>케어 플랜 수립 및 평가</li>
            <li>보호자 소통 채널 운영</li>
            <li>이용인 인권 위원회 운영</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 장애인활동지원사업 -->
    <section id="disability" class="content-section">
      <div class="container">
        <h2 class="section-title">장애인활동지원 사업</h2>

        <div class="detail-box">
          <h3>서비스 범위 및 특징</h3>
          <ul class="feature-list">
            <li>일상생활 및 사회활동 지원</li>
            <li>개인별 맞춤 서비스 제공</li>
            <li>24시간 활동지원 서비스 운영</li>
            <li>이용인 중심의 서비스 품질 관리</li>
          </ul>
        </div>

        <div class="detail-box">
          <h3>장애인 권리 증진 방안</h3>
          <ul class="feature-list">
            <li>장애인 자기결정권 존중</li>
            <li>개인별 맞춤형 지원계획 수립 및 실행</li>
            <li>장애인 인권교육 정기 실시</li>
            <li>서비스 이용인 권리 옹호 시스템 구축</li>
          </ul>
        </div>

        <div class="detail-box">
          <h3>지역사회와의 연계</h3>
          <ul class="feature-list">
            <li>지역 장애인 단체와 협력 네트워크 구축</li>
            <li>지역사회 자원 연계 및 활용</li>
            <li>장애인 가족 지원 프로그램 운영</li>
            <li>지역 내 장애이해 캠페인 활동 추진</li>
          </ul>
        </div>

        <div class="detail-box">
          <h3>전문 인력 확보 및 교육</h3>
          <ul class="feature-list">
            <li>전문 활동지원사 양성 교육 프로그램</li>
            <li>정기적인 보수교육 및 역량강화 교육</li>
            <li>활동지원사를 위한 인권교육</li>
            <li>이용인을 위한 인권교육</li>
            <li>직원 복지 향상을 통한 서비스 질 개선</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 아동청소년성장지원사업 -->
    <section id="youth" class="content-section bg-light">
      <div class="container">
        <h2 class="section-title">아동청소년성장지원 사업</h2>

        <div class="intro-text">
          <p>
            가치로운은 아동청소년의 건강한 성장과 발달을 위해 다양한 프로그램을 제공합니다.
            지역사회와 협력하여 청소년들의 잠재력을 개발하고, 사회적 책임감을 기우는 데 중점을 둡니다.
            이를 통해 미래 사회의 주역으로 성장할 수 있도록 지원합니다.
          </p>
        </div>

        <div class="youth-programs">
          <div class="program-card">
            <h3>청소년 인권보호사업</h3>
            <ul>
              <li>금연 지도 및 계도</li>
              <li>학교폭력, 마약, 도박, 딥페이크 근절 캠페인</li>
            </ul>
          </div>

          <div class="program-card">
            <h3>안전한 학교주변 환경조성 사업</h3>
            <ul>
              <li>유해업소 청소년 출입 점검</li>
              <li>등하굣길 도로안전 개선사업</li>
            </ul>
          </div>

          <div class="program-card">
            <h3>건강한 시민, 사회참여 연계사업</h3>
            <ul>
              <li>아동청소년 자원봉사 연계</li>
              <li>아동장애인과의 1:1 결연 후원</li>
            </ul>
          </div>

          <div class="program-card">
            <h3>환경교육 및 기후위기 캠페인</h3>
            <ul>
              <li>환경보호 교육 프로그램</li>
              <li>지역사회 기후위기 대응 활동</li>
            </ul>
          </div>

          <div class="program-card">
            <h3>예술로 연결되는 정서적 회복 사업</h3>
            <ul>
              <li>아동청소년/학부모 오케스트라 운영 지원</li>
              <li>아동청소년 역사문화탐방 지원</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .page-container {
    width: 100%;
  }

  .content-section {
    padding: var(--spacing-4xl) 0;
    scroll-margin-top: 80px;
  }

  .content-section.bg-light {
    background-color: var(--color-bg-light);
  }

  /* 주요 사업 활동 */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-2xl);
  }

  .service-card {
    background: white;
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border-top: 4px solid var(--color-primary-600);
  }

  .service-card h3 {
    color: var(--color-primary-600);
    margin-bottom: var(--spacing-lg);
    font-size: 1.3rem;
  }

  .service-card ul {
    list-style: none;
    padding: 0;
  }

  .service-card li {
    padding: var(--spacing-sm) 0 var(--spacing-sm) var(--spacing-lg);
    position: relative;
    border-left: 3px solid var(--color-accent-500);
    margin-bottom: var(--spacing-sm);
  }

  /* 상세 박스 */
  .detail-box {
    background: white;
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-2xl);
    box-shadow: var(--shadow-sm);
  }

  .detail-box h3 {
    color: var(--color-primary-600);
    margin-bottom: var(--spacing-lg);
    font-size: 1.4rem;
    padding-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--color-primary-600);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-lg);
  }

  .content-item strong {
    display: block;
    color: var(--color-primary-600);
    font-size: 1.1rem;
    margin-bottom: var(--spacing-sm);
  }

  .content-item ul {
    list-style: none;
    padding: 0;
  }

  .content-item li {
    padding: var(--spacing-xs) 0 var(--spacing-xs) var(--spacing-md);
    border-left: 3px solid var(--color-accent-500);
    margin-bottom: var(--spacing-xs);
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin-top: var(--spacing-lg);
  }

  .feature-list li {
    padding: var(--spacing-md) var(--spacing-lg);
    background: var(--color-gray-50);
    border-left: 4px solid var(--color-primary-600);
    margin-bottom: var(--spacing-md);
    border-radius: var(--radius-sm);
  }

  /* 아동청소년 */
  .intro-text {
    background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-accent-50) 100%);
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-3xl);
    text-align: center;
  }

  .intro-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 900px;
    margin: 0 auto;
  }

  .youth-programs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-2xl);
  }

  .program-card {
    background: white;
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border-left: 4px solid var(--color-accent-600);
  }

  .program-card h3 {
    color: var(--color-primary-600);
    margin-bottom: var(--spacing-lg);
    font-size: 1.2rem;
  }

  .program-card ul {
    list-style: none;
    padding: 0;
  }

  .program-card li {
    padding: var(--spacing-sm) 0;
    padding-left: var(--spacing-md);
    position: relative;
  }

  .program-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-accent-600);
    font-weight: bold;
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .youth-programs {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Smooth scroll for hashbang navigation
  document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash;
    if (hash) {
      setTimeout(() => {
        const element = document.querySelector(hash);
        if (element) {
          element.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 100);
    }
  });

  // Track hashbang navigation
  window.addEventListener('hashchange', () => {
    if (typeof window.gtag !== 'undefined') {
      window.gtag('config', 'GTM-MVL6P7N7', {
        page_path: window.location.pathname + window.location.hash
      });
    }
  });
</script>
