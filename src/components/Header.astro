---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '홈' },
  { href: '/about', label: '가치로운이란?', 
    children: [
      { href: '/about#purpose', label: '설립 목적 및 비전' },
      { href: '/about#values', label: '가치란' },
      { href: '/about#cooperative', label: '사회적협동조합이란' },
      { href: '/about#greeting', label: '인사말' },
      { href: '/about#vision', label: '경영철학 & 비전' },
      { href: '/about#gangnam', label: '가치로운 강남구' },
      { href: '/about#access', label: '가치로운 접근성' },
      { href: '/about#organization', label: '조직도' },
      { href: '/about#history', label: '연혁' },
      { href: '/about#location', label: '사무실 위치' },
    ]
  },
  { href: '/services', label: '사업소개',
    children: [
      { href: '/services#overview', label: '주요 사업 활동' },
      { href: '/services#elderly', label: '재가방문요양사업' },
      { href: '/services#disability', label: '장애인활동지원사업' },
      { href: '/services#youth', label: '아동청소년성장지원사업' },
    ]
  },
  { href: '/notice', label: '안내사항',
    children: [
      { href: '/notice#announcements', label: '공지사항' },
      { href: '/notice#events', label: '행사일정' },
      { href: '/notice#volunteer', label: '봉사활동 신청' },
      { href: '/notice#donation', label: '정기후원 신청' },
    ]
  },
  { href: '/resources', label: '자료실',
    children: [
      { href: '/resources#activities', label: '활동 내역' },
      { href: '/resources#downloads', label: '서식 다운로드' },
    ]
  },
];
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <a href="/" class="logo">
        <img src="/images/main-logo.png" alt="사회적협동조합 가치로운" class="logo-img" />
      </a>
      
      <a href="tel:02-6952-4756" class="header-phone">
        <span class="phone-icon">📞</span>
        <span class="phone-number">02-6952-4756</span>
      </a>
      
      <button class="mobile-menu-toggle" aria-label="메뉴 열기">
        <span></span>
        <span></span>
        <span></span>
      </button>
      
      <ul class="nav-menu">
        {navItems.map((item) => {
          const isActive = item.href === '/' ? (currentPath === '/') : currentPath.startsWith(item.href);
          return (
            <li class="nav-item" class:list={[{ 'has-dropdown': item.children }]}>
              <a 
                href={item.href} 
                class:list={['nav-link', { active: isActive }]}
              >
                {item.label}
              </a>
              {item.children && (
                <ul class="dropdown">
                  {item.children.map((child) => (
                    <li>
                      <a 
                        href={child.href}
                        class:list={['dropdown-link', { active: currentPath === child.href }]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background-color: white;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md) 0;
  }
  
  .logo {
    display: flex;
    align-items: center;
  }
  
  .logo-img {
    height: 50px;
    max-width: 300px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  
  .logo-img:hover {
    transform: scale(1.05);
  }
  
  .header-phone {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-primary-600);
    font-weight: 600;
    font-size: 1.1rem;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
    text-decoration: none;
  }
  
  .header-phone:hover {
    background-color: var(--color-primary-50);
    transform: scale(1.05);
  }
  
  .phone-icon {
    font-size: 1.3rem;
  }
  
  .phone-number {
    letter-spacing: 0.5px;
  }
  
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--spacing-sm);
  }
  
  .mobile-menu-toggle span {
    display: block;
    width: 25px;
    height: 3px;
    background-color: var(--color-gray-700);
    border-radius: 2px;
    transition: all 0.3s ease;
  }
  
  .nav-menu {
    display: flex;
    list-style: none;
    gap: var(--spacing-xl);
    margin: 0;
  }
  
  .nav-item {
    position: relative;
  }
  
  .nav-link {
    color: var(--color-gray-700);
    font-weight: 500;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
    display: block;
  }
  
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary-600);
    background-color: var(--color-primary-50);
  }
  
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown,
  .has-dropdown .dropdown:hover {
    display: block;
  }
  
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: white;
    box-shadow: var(--shadow-lg);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    min-width: 200px;
    list-style: none;
    margin: -4px 0 0 0; /* overlap menu bar to remove mouse gap */
    z-index: 1002;
  }
  
  .dropdown-link {
    display: block;
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-gray-700);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }
  
  .dropdown-link:hover,
  .dropdown-link.active {
    background-color: var(--color-primary-50);
    color: var(--color-primary-600);
  }
  
  /* 모바일 */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
    }
    
    .nav-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: white;
      flex-direction: column;
      gap: 0;
      padding: var(--spacing-md);
      box-shadow: var(--shadow-md);
    }
    
    .nav-menu.active {
      display: flex;
    }
    
    .dropdown {
      position: static;
      box-shadow: none;
      padding-left: var(--spacing-lg);
      margin-top: var(--spacing-sm);
      display: block !important;
    }
  }
</style>

<script>
  // 모바일 메뉴 토글
  const toggle = document.querySelector('.mobile-menu-toggle');
  const menu = document.querySelector('.nav-menu');
  
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('active');
  });
  
  // 드롭다운 모바일 처리
  if (window.innerWidth <= 768) {
    const dropdownItems = document.querySelectorAll('.has-dropdown > .nav-link');
    dropdownItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const parent = (e.target as HTMLElement).closest('.has-dropdown');
        parent?.classList.toggle('active');
      });
    });
  }
</script>
