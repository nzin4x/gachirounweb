---
import { navigation, type NavItem } from '../data/navigation';

const currentPath = Astro.url.pathname;
const navItems = navigation;
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <a href="/" class="logo">
        <img src="/images/main-logo.png" alt="사회적협동조합 가치로운" class="logo-img" />
      </a>
      
      <a href="tel:02-6952-4756" class="header-phone">
        <span class="phone-icon">📞</span>
        <span class="phone-number">02-6952-4756</span>
      </a>
      
      <button class="mobile-menu-toggle" aria-label="메뉴 열기">
        <span></span>
        <span></span>
        <span></span>
      </button>
      
      <ul class="nav-menu">
        {navItems.map((item: NavItem) => {
          const isActive = item.href === '/' ? (currentPath === '/') : currentPath.startsWith(item.href);
          return (
            <li class="nav-item" class:list={[{ 'has-dropdown': item.children }]}>
              <a 
                href={item.href} 
                class:list={['nav-link', { active: isActive }]}
              >
                {item.label}
              </a>
              {item.children && (
                <ul class="dropdown">
                  {item.children.map((child: NavItem) => (
                    <li>
                      <a 
                        href={child.href}
                        class:list={['dropdown-link', { active: currentPath === child.href }]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background-color: white;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md) 0;
  }
  
  .logo {
    display: flex;
    align-items: center;
  }
  
  .logo-img {
    height: 50px;
    max-width: 300px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  
  .logo-img:hover {
    transform: scale(1.05);
  }
  
  .header-phone {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-primary-600);
    font-weight: 600;
    font-size: 1.1rem;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
    text-decoration: none;
    white-space: nowrap;
  }
  
  .header-phone:hover {
    background-color: var(--color-primary-50);
    transform: scale(1.05);
  }
  
  /* 모바일 메뉴 열렸을 때 body 스크롤 방지 */
  body.menu-open {
    overflow: hidden !important;
  }
  
  .phone-icon {
    font-size: 1.3rem;
  }
  .phone-number {
    letter-spacing: 0.5px;
  }
  @media (max-width: 768px) {
    .header-phone {
      font-size: 0.9rem;
    }
    .phone-icon {
      font-size: 1em;
    }
    .phone-number {
      font-size: 0.9em;
    }
  }
  
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--spacing-sm);
  }
  
  .mobile-menu-toggle span {
    display: block;
    width: 25px;
    height: 3px;
    background-color: var(--color-gray-700);
    border-radius: 2px;
    transition: all 0.3s ease;
  }
  
  .nav-menu {
    display: flex;
    list-style: none;
    gap: var(--spacing-xl);
    margin: 0;
  }
  
  .nav-item {
    position: relative;
  }
  
  .nav-link {
    color: var(--color-gray-700);
    font-weight: 500;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
    display: block;
  }
  
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary-600);
    background-color: var(--color-primary-50);
  }
  
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown,
  .has-dropdown .dropdown:hover {
    display: block;
  }
  
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: white;
    box-shadow: var(--shadow-lg);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    min-width: 300px;
    list-style: none;
    margin: -4px 0 0 0; /* overlap menu bar to remove mouse gap */
    z-index: 1002;
  }
  
  .dropdown-link {
    display: block;
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-gray-700);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }
  
  .dropdown-link:hover,
  .dropdown-link.active {
    background-color: var(--color-primary-50);
    color: var(--color-primary-600);
  }
  
  /* 모바일 */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
    }
    
    /* 모바일 메뉴 컨테이너 */
    .nav-menu {
      display: none;
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 75%;
      max-width: 320px;
      background: white;
      flex-direction: column;
      gap: 0;
      padding: var(--spacing-2xl) var(--spacing-lg);
      box-shadow: -4px 0 20px rgba(0, 0, 0, 0.3);
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      z-index: 2000;
    }
    
    .nav-menu.active {
      display: flex;
      transform: translateX(0);
    }
    
    /* 메뉴 아이템 간격 */
    .nav-item {
      margin-bottom: var(--spacing-xs);
    }
    
    /* 메인 메뉴 링크 */
    .nav-link {
      display: block;
      padding: var(--spacing-md) var(--spacing-lg);
      color: var(--color-gray-900);
      background: var(--color-gray-50);
      border-radius: var(--radius-sm);
      font-size: 1rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    
    .nav-link:hover,
    .nav-link.active {
      background: linear-gradient(90deg, var(--color-primary-500), var(--color-accent-500));
      color: white;
    }
    
    /* 드롭다운 컨테이너 */
    .dropdown {
      position: static;
      box-shadow: none;
      background: transparent;
      padding: var(--spacing-xs) 0 0 var(--spacing-md);
      margin: 0;
      display: block !important;
      border-left: 1px solid var(--color-gray-300);
      margin-left: var(--spacing-md);
    }
    
    /* 서브 메뉴 링크 */
    .dropdown-link {
      display: block;
      padding: var(--spacing-sm) var(--spacing-md);
      color: var(--color-gray-700);
      background: transparent;
      border-left: none;
      font-size: 0.875rem;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    
    .dropdown-link:hover,
    .dropdown-link.active {
      color: var(--color-primary-600);
      background: var(--color-primary-50);
    }
  }
</style>

<script>
  // 모바일 메뉴 토글
  const toggle = document.querySelector('.mobile-menu-toggle');
  const menu = document.querySelector('.nav-menu');
  
  toggle?.addEventListener('click', () => {
    const isActive = menu?.classList.toggle('active');
    
    // 메뉴 열릴 때 배경 스크롤 방지 (강력하게)
    if (isActive) {
      document.body.classList.add('menu-open');
      document.documentElement.style.overflow = 'hidden';
    } else {
      document.body.classList.remove('menu-open');
      document.documentElement.style.overflow = '';
    }
  });
  
  // 오버레이 클릭 시 메뉴 닫기
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (menu?.classList.contains('active') && 
        !menu.contains(target) && 
        !toggle?.contains(target)) {
      menu.classList.remove('active');
      document.body.classList.remove('menu-open');
      document.documentElement.style.overflow = '';
    }
  });
  
  // 메뉴 링크 클릭 시 메뉴 닫기 (모바일)
  if (window.innerWidth <= 768) {
    const allLinks = menu?.querySelectorAll('a');
    allLinks?.forEach((link) => {
      link.addEventListener('click', () => {
        // 레이어 팝업도 함께 닫기
        const popup = document.getElementById('layerPopup');
        if (popup) {
          popup.classList.add('hidden');
        }
        
        // 메뉴 닫기
        menu?.classList.remove('active');
        document.body.classList.remove('menu-open');
        document.documentElement.style.overflow = '';
      });
    });
  }
  
</script>
