---
const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    title: '소개',
    links: [
      { href: '/about', label: '조합 소개' },
      { href: '/about/history', label: '연혁' },
      { href: '/about/organization', label: '조직도' },
      { href: '/about/location', label: '오시는 길' },
    ],
  },
  {
    title: '사업안내',
    links: [
      { href: '/services/elderly', label: '노인복지' },
      { href: '/services/disability', label: '장애인 지원' },
      { href: '/services/youth', label: '청소년 지원' },
    ],
  },
  {
    title: '소식',
    links: [
      { href: '/notice', label: '공지사항' },
      { href: '/recruit', label: '활동지원사 구직신청' },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <div class="footer-logo">
          <img src="/images/main-logo.png" alt="사회적협동조합 가치로운" class="footer-logo-img" />
        </div>
        <p class="footer-description">
          더불어 함께 살아가는 사회적 가치 실현
        </p>
      </div>
      
      {footerLinks.map((section) => (
        <div class="footer-section">
          <h3 class="footer-title">{section.title}</h3>
          <ul class="footer-links">
            {section.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      
      <div class="footer-section">
        <h3 class="footer-title">연락처</h3>
        <ul class="footer-contact">
          <li>📞 010-6549-8765</li>
          <li>📧 nzin4x@gmail.com</li>
          <li>📍 서울 강남구 테헤란로 406</li>
          <li>샹제리제타워 A동 C111호</li>
        </ul>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {currentYear} 사회적협동조합 가치로운. All rights reserved.</p>
      <div class="footer-legal">
        <a href="/privacy">개인정보처리방침</a>
        <span>|</span>
        <a href="/terms">이용약관</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(135deg, var(--color-primary-700) 0%, var(--color-primary-900) 100%);
    color: white;
    padding: var(--spacing-3xl) 0 var(--spacing-xl);
    margin-top: var(--spacing-3xl);
  }
  
  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr;
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-2xl);
  }
  
  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  
  .footer-logo {
    display: flex;
    align-items: center;
    margin-bottom: var(--spacing-md);
  }
  
  .footer-logo-img {
    height: 56px;
    max-width: 320px;
    object-fit: contain;
  }
  
  .footer-description {
    font-size: 0.9rem;
    line-height: 1.6;
    opacity: 0.9;
  }
  
  .footer-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: var(--spacing-sm);
  }
  
  .footer-links,
  .footer-contact {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  
  .footer-links a {
    color: white;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }
  
  .footer-links a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  
  .footer-contact li {
    opacity: 0.9;
    font-size: 0.9rem;
  }
  
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--spacing-xl);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.9rem;
  }
  
  .footer-legal {
    display: flex;
    gap: var(--spacing-md);
    align-items: center;
  }
  
  .footer-legal a {
    color: white;
    opacity: 0.9;
  }
  
  .footer-legal a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  
  /* 모바일 */
  @media (max-width: 768px) {
    .footer {
      padding: var(--spacing-2xl) 0 var(--spacing-lg);
    }
    
    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
    
    .footer-bottom {
      flex-direction: column;
      gap: var(--spacing-md);
      text-align: center;
    }
  }
</style>
