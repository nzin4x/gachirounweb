---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getFloatingNavItems } from '../data/navigation';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_ID;

// 현재 페이지의 플로팅 네비게이션 아이템 가져오기
const floatingNavItems = getFloatingNavItems(Astro.url.pathname);
const hasFloatingNav = floatingNavItems.length > 0;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <SEO title={title} description={description} image={image} type={type} />
    
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MVL6P7N7');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MVL6P7N7"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <Header />
    
    <!-- 플로팅 네비게이션 -->
    <aside id="floatingNav" class="floating-nav hidden collapsed">
      <div class="floating-nav-header">
        <button class="floating-nav-pin" aria-label="네비게이션 고정(PIN)">
          <span class="pin-icon">📌</span>
        </button>
      </div>
      <button class="floating-nav-toggle" aria-label="네비게이션 토글">
        <span class="toggle-icon">�</span>
      </button>
      <div class="floating-nav-content">
        <!-- 동적으로 채워집니다 -->
      </div>
    </aside>

<style is:global>
  .floating-nav-header {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 0.25rem 0.5rem 0 0.5rem;
    box-sizing: border-box;
    position: relative;
    min-height: 32px;
  }
  .floating-nav-pin {
    position: static;
    top: auto;
    right: auto;
    transform: none;
    margin-top: 0;
    margin-right: 0;
    width: 28px;
    height: 32px;
    background: white;
    border: 1px solid var(--color-primary-200);
    border-radius: var(--radius-md);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(255, 107, 53, 0.08);
    transition: all 0.2s;
    z-index: 2;
    font-size: 1.1rem;
    color: var(--color-primary-500);
    opacity: 0.85;
  }
  .floating-nav-pin.active {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
    border-color: var(--color-primary-400);
    opacity: 1;
  }
</style>
    
    <!-- 플로팅 네비게이션 데이터 (숨김) -->
    {hasFloatingNav && (
      <script id="floating-nav-data" type="application/json" set:html={JSON.stringify(floatingNavItems)} />
    )}
    
    <!-- 맨 위로 버튼 -->
    <button id="scrollToTop" class="scroll-to-top hidden" aria-label="맨 위로">
      <span class="scroll-icon">↑</span>
    </button>
    
    
    <main>
      <slot />
    </main>
    <Footer />
    
    <!-- 전역 스크립트: 섹션 해시 추적 -->
    <script>
      // IntersectionObserver로 현재 보이는 섹션을 추적하여 URL 해시 업데이트
      document.addEventListener('DOMContentLoaded', () => {
        const sections = document.querySelectorAll('section[id]');
        if (sections.length === 0) return;

        const observerOptions = {
          root: null,
          rootMargin: '-50% 0px -50% 0px', // 뷰포트 중앙에 위치한 섹션 감지
          threshold: 0,
        };

        let isManualScroll = true;

        const observer = new IntersectionObserver((entries) => {
          if (!isManualScroll) return;

          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              
              // URL 해시 업데이트 (히스토리에 추가하지 않음)
              if (window.location.hash !== `#${id}`) {
                history.replaceState(null, '', `#${id}`);
              }
            }
          });
        }, observerOptions);

        sections.forEach((section) => {
          observer.observe(section);
        });

        // 해시 링크 클릭 시 일시적으로 자동 추적 중지
        document.querySelectorAll('a[href^="#"]').forEach((link) => {
          link.addEventListener('click', () => {
            isManualScroll = false;
            setTimeout(() => {
              isManualScroll = true;
            }, 1000); // 1초 후 재개
          });
        });
        
        // 섹션 제목 클릭 시 URL 복사 (전역 적용)
        document.querySelectorAll('.clickable-title').forEach(title => {
          title.addEventListener('click', async (e) => {
            const titleElement = e.target as HTMLElement;
            const section = titleElement.closest('section');
            if (!section?.id) return;
            
            const url = `${window.location.origin}${window.location.pathname}#${section.id}`;
            
            try {
              await navigator.clipboard.writeText(url);
              
              // 복사 성공 피드백 - 작은 텍스트로 우측에 표시
              let feedback = titleElement.querySelector('.copy-feedback');
              if (!feedback) {
                feedback = document.createElement('span');
                feedback.className = 'copy-feedback';
                titleElement.appendChild(feedback);
              }
              
              feedback.textContent = '위치 복사됨✓ - 공유할 곳에 붙여 넣으세요!';
              feedback.classList.add('show');
              
              setTimeout(() => {
                feedback?.classList.remove('show');
              }, 2000);
            } catch (err) {
              console.error('URL 복사 실패:', err);
            }
          });
        });
        
        // 플로팅 네비게이션 구성
        const floatingNav = document.getElementById('floatingNav');
        const floatingNavContent = floatingNav?.querySelector('.floating-nav-content');
        
        // 서버에서 전달된 네비게이션 데이터 사용
        const navDataElement = document.getElementById('floating-nav-data');
        const hasNavData = navDataElement && navDataElement.textContent;
        
        if (hasNavData && floatingNavContent) {
          const navItems = JSON.parse(navDataElement.textContent || '[]');
          
          // HTML 생성
          const navHTML = navItems.map((item: any) => {
            const hash = item.href.split('#')[1] || '';
            return `
              <a href="${item.href}" class="floating-nav-item" data-section="${hash}">
                ${item.label}
              </a>
            `;
          }).join('');
          
          floatingNavContent.innerHTML = navHTML;
          
          // 스크롤 시 active 상태 업데이트
          const updateActiveNav = () => {
            let currentSection = '';
            
            sections.forEach(section => {
              const rect = section.getBoundingClientRect();
              if (rect.top <= 150 && rect.bottom >= 150) {
                currentSection = section.id;
              }
            });
            
            document.querySelectorAll('.floating-nav-item').forEach(item => {
              const navItem = item as HTMLElement;
              navItem.classList.toggle('active', navItem.dataset.section === currentSection);
            });
          };
          
          // 스크롤 이벤트
          let scrollTimeout: number;
          window.addEventListener('scroll', () => {
            clearTimeout(scrollTimeout);
            scrollTimeout = window.setTimeout(updateActiveNav, 50);
            
            // 스크롤이 일정 이상 되면 네비게이션 표시
            if (window.scrollY > 300) {
              floatingNav?.classList.remove('hidden');
            } else {
              floatingNav?.classList.add('hidden');
            }
          });
          
          // 초기 active 상태 설정
          updateActiveNav();
        }
        
        // PIN 버튼 기능 추가
        const toggleButton = floatingNav?.querySelector('.floating-nav-toggle');
        const pinButton = floatingNav?.querySelector('.floating-nav-pin');
        let isPinned = localStorage.getItem('floatingNavPinned') === 'true';
        function updatePinUI() {
          if (isPinned) {
            floatingNav?.classList.add('pinned');
            pinButton?.classList.add('active');
          } else {
            floatingNav?.classList.remove('pinned');
            pinButton?.classList.remove('active');
          }
        }
        updatePinUI();

        pinButton?.addEventListener('click', (e) => {
          e.stopPropagation();
          isPinned = !isPinned;
          localStorage.setItem('floatingNavPinned', isPinned ? 'true' : 'false');
          updatePinUI();
        });

        // 플로팅 네비게이션 전체 영역 클릭 시 (닫혀있을 때만 열기)
        floatingNav?.addEventListener('click', (e) => {
          const isCollapsed = floatingNav?.classList.contains('collapsed');
          const target = e.target as HTMLElement;
          const isToggle = target.closest('.floating-nav-toggle');
          const isContent = target.closest('.floating-nav-content');
          const isNavItem = target.closest('.floating-nav-item');
          const isPin = target.closest('.floating-nav-pin');
          if (
            isCollapsed &&
            !isNavItem &&
            !isContent &&
            !isPin
          ) {
            e.preventDefault();
            e.stopPropagation();
            floatingNav?.classList.remove('collapsed');
            localStorage.setItem('floatingNavCollapsed', 'false');
          }
        });

        // 토글 버튼만 클릭 시 열고/닫기 토글
        toggleButton?.addEventListener('click', (e) => {
          e.stopPropagation();
          floatingNav?.classList.toggle('collapsed');
          const isCollapsed = floatingNav?.classList.contains('collapsed');
          localStorage.setItem('floatingNavCollapsed', isCollapsed ? 'true' : 'false');
        });

        // 모바일/PC 모두 본문 클릭 시 닫기 (PIN 해제 시에만)
        document.addEventListener('click', (e) => {
          if (isPinned) return;
          const target = e.target as HTMLElement;
          const isNavClick = floatingNav?.contains(target);
          const isToggleClick = toggleButton?.contains(target);
          const isPinClick = pinButton?.contains(target);
          if (!floatingNav?.classList.contains('collapsed') && !isNavClick && !isToggleClick && !isPinClick) {
            floatingNav?.classList.add('collapsed');
            localStorage.setItem('floatingNavCollapsed', 'true');
          }
        });

        // 페이지 로드 시 저장된 상태 복원
        const savedState = localStorage.getItem('floatingNavCollapsed');
        if (isPinned) {
          floatingNav?.classList.remove('collapsed');
        } else if (savedState === 'false') {
          floatingNav?.classList.remove('collapsed');
        } else {
          floatingNav?.classList.add('collapsed');
        }
        
        // 맨 위로 버튼 동작
        const scrollToTopBtn = document.getElementById('scrollToTop');
        const footer = document.querySelector('.footer');
        
        if (scrollToTopBtn && footer) {
          // 스크롤 시 버튼 표시/숨김
          let scrollTimeout: number;
          window.addEventListener('scroll', () => {
            clearTimeout(scrollTimeout);
            scrollTimeout = window.setTimeout(() => {
              const footerRect = footer.getBoundingClientRect();
              const windowHeight = window.innerHeight;
              
              // 푸터가 화면에 보이기 시작하면 버튼 표시
              if (footerRect.top <= windowHeight) {
                scrollToTopBtn.classList.remove('hidden');
              } else {
                scrollToTopBtn.classList.add('hidden');
              }
            }, 50);
          });
          
          // 버튼 클릭 시 맨 위로 스크롤
          scrollToTopBtn.addEventListener('click', () => {
            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });
          });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  main {
    min-height: 60vh;
  }
  
  /* 섹션 스크롤 애니메이션 */
  section[id] {
    scroll-margin-top: 80px; /* 헤더 높이만큼 여백 */
  }
  
  /* 플로팅 네비게이션 */
  .floating-nav {
    position: fixed;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    max-width: 220px;
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    transition: all 0.3s ease;
    opacity: 1;
  }
  
  .floating-nav.hidden {
    opacity: 0;
    transform: translateY(-50%) translateX(-100%);
    pointer-events: none;
  }
  
  /* 토글 버튼 - 세로 바 형태 */
  .floating-nav-toggle {
    position: absolute;
    right: -8px;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 120px;
    background: linear-gradient(to bottom, 
      var(--color-primary-500) 0%, 
      var(--color-accent-500) 100%);
    border: none;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    z-index: 2;
    overflow: hidden;
  }

  .floating-nav.pinned {
    box-shadow: 0 0 0 3px var(--color-primary-200);
  }
  
  .floating-nav-toggle:hover {
    width: 12px;
    box-shadow: 2px 0 12px rgba(255, 107, 53, 0.3);
  }
  
  .toggle-icon {
    display: none; /* 아이콘 숨김 */
  }
  
  /* 토글 바에 물결 효과 추가 */
  .floating-nav-toggle::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 100%);
    animation: wave 2s ease-in-out infinite;
  }
  
  @keyframes wave {
    0%, 100% {
      transform: translateY(-100%);
    }
    50% {
      transform: translateY(100%);
    }
  }
  
  .floating-nav.collapsed {
    transform: translateY(-50%) translateX(-100%);
  }
  
  .floating-nav.collapsed .floating-nav-toggle {
    right: -8px;
  }
  
  .floating-nav-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    max-height: 70vh;
    overflow-y: auto;
    padding: var(--spacing-md);
    opacity: 1;
    transition: opacity 0.3s ease;
  }
  
  .floating-nav.collapsed .floating-nav-content {
    opacity: 0;
  }
  
  .floating-nav-content::-webkit-scrollbar {
    width: 4px;
  }
  
  .floating-nav-content::-webkit-scrollbar-thumb {
    background: var(--color-primary-300);
    border-radius: 2px;
  }
  
  .floating-nav-item {
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: 0.875rem;
    color: var(--color-gray-600);
    text-decoration: none;
    border-left: 3px solid var(--color-gray-200);
    transition: all 0.2s ease;
    display: block;
    line-height: 1.4;
  }
  
  .floating-nav-item:hover {
    color: var(--color-primary-600);
    background: var(--color-primary-50);
    border-left-color: var(--color-primary-400);
    padding-left: calc(var(--spacing-md) + 4px);
  }
  
  .floating-nav-item.active {
    color: var(--color-primary-600);
    background: linear-gradient(to right, var(--color-primary-50) 0%, transparent 100%);
    border-left-color: var(--color-primary-600);
    font-weight: 600;
    padding-left: calc(var(--spacing-md) + 4px);
  }
  
  /* 태블릿에서는 크기 축소 */
  @media (max-width: 1280px) {
    .floating-nav {
      left: 1rem;
      max-width: 180px;
    }
    
    .floating-nav-item {
      font-size: 0.8125rem;
      padding: var(--spacing-xs) var(--spacing-sm);
    }
  }
  
  /* 모바일에서도 사용 가능하도록 */
  @media (max-width: 1024px) {
    .floating-nav {
      left: 0.5rem;
      max-width: 160px;
      /* display: block으로 유지 */
    }
    
    .floating-nav-toggle {
      right: -6px;
      width: 6px;
      height: 100px;
    }
    
    .floating-nav-toggle:hover {
      width: 10px;
    }
    
    .floating-nav-content {
      padding: var(--spacing-sm);
    }
    
    .floating-nav-item {
      font-size: 0.75rem;
      padding: 0.375rem 0.5rem;
    }
    
    /* 모바일에서는 기본적으로 접힌 상태 */
    .floating-nav:not(.hidden) {
      transform: translateY(-50%) translateX(-100%);
    }
    
    .floating-nav:not(.hidden):not(.collapsed) {
      transform: translateY(-50%) translateX(0);
    }
    
    /* 모바일에서 링크 이모지 제거 */
    .clickable-title:hover::after {
      display: none;
    }
  }
  

  /* 맨 위로 버튼 - PC 중앙, 모바일/태블릿 우측 */
  .scroll-to-top {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    transform: translate(-50%, 0);
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--color-primary-500) 0%, var(--color-accent-500) 100%);
    color: white;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
    transition: all 0.3s ease;
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
  }

  .scroll-to-top.hidden {
    opacity: 0;
    transform: translate(-50%, 20px);
    pointer-events: none;
  }

  .scroll-to-top:hover {
    transform: translate(-50%, -4px);
    box-shadow: 0 6px 16px rgba(255, 107, 53, 0.4);
  }

  .scroll-to-top .scroll-icon {
    font-size: 1.5rem;
    font-weight: bold;
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  /* 모바일/태블릿(최대 768px)에서는 우측 하단 */
  @media (max-width: 768px) {
    .scroll-to-top {
      left: auto;
      right: 1rem;
      bottom: 1rem;
      width: 48px;
      height: 48px;
      transform: translateY(0);
    }
    .scroll-to-top.hidden {
      opacity: 0;
      transform: translateY(20px);
    }
    .scroll-to-top .scroll-icon {
      font-size: 1.25rem;
    }
  }

  /* clickable-title 전역 스타일 */
  .clickable-title {
    cursor: pointer;
    position: relative;
    display: inline-block;
    transition: color 0.2s ease;
  }

  .clickable-title:hover {
    color: var(--color-primary-500);
  }

  .clickable-title:hover::after {
    /* content: '🔗'; */
    margin-left: 0.5rem;
    font-size: 0.65rem;
    opacity: 0.6;
    vertical-align: middle;
  }
  
  .clickable-title .copy-feedback {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.65rem;
    color: var(--color-secondary-600);
    margin-left: 0.5rem;
    font-weight: 500;
    opacity: 0;
    transition: opacity 0.2s ease;
    vertical-align: middle;
  }
  
  .clickable-title .copy-feedback::before {
    content: '🔗';
    font-size: 1em;
  }
  
  .clickable-title .copy-feedback.show {
    opacity: 1;
  }
</style>
