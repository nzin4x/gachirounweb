---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <SEO title={title} description={description} image={image} type={type} />
    
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MVL6P7N7');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MVL6P7N7"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    
    <!-- 전역 스크립트: 섹션 해시 추적 -->
    <script>
      // IntersectionObserver로 현재 보이는 섹션을 추적하여 URL 해시 업데이트
      document.addEventListener('DOMContentLoaded', () => {
        const sections = document.querySelectorAll('section[id]');
        if (sections.length === 0) return;

        const observerOptions = {
          root: null,
          rootMargin: '-50% 0px -50% 0px', // 뷰포트 중앙에 위치한 섹션 감지
          threshold: 0,
        };

        let isManualScroll = true;

        const observer = new IntersectionObserver((entries) => {
          if (!isManualScroll) return;

          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              
              // URL 해시 업데이트 (히스토리에 추가하지 않음)
              if (window.location.hash !== `#${id}`) {
                history.replaceState(null, '', `#${id}`);
              }
            }
          });
        }, observerOptions);

        sections.forEach((section) => {
          observer.observe(section);
        });

        // 해시 링크 클릭 시 일시적으로 자동 추적 중지
        document.querySelectorAll('a[href^="#"]').forEach((link) => {
          link.addEventListener('click', () => {
            isManualScroll = false;
            setTimeout(() => {
              isManualScroll = true;
            }, 1000); // 1초 후 재개
          });
        });
        
        // 섹션 제목 클릭 시 URL 복사 (전역 적용)
        document.querySelectorAll('.clickable-title').forEach(title => {
          title.addEventListener('click', async (e) => {
            const titleElement = e.target as HTMLElement;
            const section = titleElement.closest('section');
            if (!section?.id) return;
            
            const url = `${window.location.origin}${window.location.pathname}#${section.id}`;
            
            try {
              await navigator.clipboard.writeText(url);
              
              // 복사 성공 피드백 - 작은 텍스트로 우측에 표시
              let feedback = titleElement.querySelector('.copy-feedback');
              if (!feedback) {
                feedback = document.createElement('span');
                feedback.className = 'copy-feedback';
                titleElement.appendChild(feedback);
              }
              
              feedback.textContent = '복사됨 ✓';
              feedback.classList.add('show');
              
              setTimeout(() => {
                feedback?.classList.remove('show');
              }, 2000);
            } catch (err) {
              console.error('URL 복사 실패:', err);
            }
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  main {
    min-height: 60vh;
  }
  
  /* 섹션 스크롤 애니메이션 */
  section[id] {
    scroll-margin-top: 80px; /* 헤더 높이만큼 여백 */
  }
  
  /* clickable-title 전역 스타일 */
  .clickable-title {
    cursor: pointer;
    position: relative;
    display: inline-block;
    transition: color 0.2s ease;
  }

  .clickable-title:hover {
    color: var(--color-primary-500);
  }

  .clickable-title:hover::after {
    content: '🔗';
    margin-left: 0.5rem;
    font-size: 0.8em;
    opacity: 0.7;
  }
  
  .clickable-title .copy-feedback {
    font-size: 0.75rem;
    color: var(--color-secondary-600);
    margin-left: 0.5rem;
    font-weight: 400;
    opacity: 0;
    transition: opacity 0.2s ease;
    vertical-align: middle;
  }
  
  .clickable-title .copy-feedback.show {
    opacity: 1;
  }
</style>
